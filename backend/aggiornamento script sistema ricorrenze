function generateShortId() {
    var now = new Date();
    var timeComponent = now.getHours() * 10000 + now.getMinutes() * 100 + now.getSeconds();
    var randomComponent = Math.floor(Math.random() * 100);
    var shortId = (timeComponent + randomComponent) % 100000;
    return shortId.toString().padStart(5, '0');
}

