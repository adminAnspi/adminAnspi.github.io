function generaReportSettimanale() {
    var weekInput = document.getElementById('reportWeekInput');
    if (!weekInput || !weekInput.value) {
        showBanner('Seleziona una settimana prima di generare il report', 'error');
        return;
    }
    var parts = weekInput.value.split('-W');
    var year = parseInt(parts[0]);
    var week = parseInt(parts[1]);
    var monday = new Date(year, 0, 1 + (week - 1) * 7);
    var day = monday.getDay();
    var diff = (day <= 4) ? 1 - day : 8 - day;
    monday.setDate(monday.getDate() + diff);
    var sunday = new Date(monday);
    sunday.setDate(monday.getDate() + 6);
    var mondayStr = monday.toISOString().split('T')[0];
    var sundayStr = sunday.toISOString().split('T')[0];

    var dataSource = calendarBookings.length > 0 ? calendarBookings : bookings;
    var eventiSettimana = dataSource.filter(function(b) {
        if (!b.data) return false;
        var dataEvento = b.data.split('T')[0];
        return dataEvento >= mondayStr && dataEvento <= sundayStr;
    });

    var calcetto   = eventiSettimana.filter(function(b) { return b.evento === 'calcetto'; });
    var pallavolo  = eventiSettimana.filter(function(b) { return b.evento === 'pallavolo'; });
    var compleanni = eventiSettimana.filter(function(b) { return b.evento === 'compleanno'; });
    var eventi     = eventiSettimana.filter(function(b) { return b.evento === 'eventi'; });

    if (typeof window.jspdf === 'undefined') {
        showBanner('Libreria PDF non disponibile', 'error');
        return;
    }

    var jsPDF = window.jspdf.jsPDF;
    var doc = new jsPDF();
    var pageWidth = doc.internal.pageSize.getWidth();
    var margin = 20;
    var y = 20;

    function fmtData(str) {
        if (!str) return '';
        var d = new Date(str.split('T')[0] + 'T00:00:00');
        return d.toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }
    function checkPage(needed) {
        if (y + needed > 270) { doc.addPage(); y = 20; }
    }

    doc.setFillColor(116, 185, 255);
    doc.rect(0, 0, pageWidth, 35, 'F');
    doc.setTextColor(255, 255, 255);
    doc.setFontSize(18);
    doc.setFont('helvetica', 'bold');
    doc.text('Campo Don Michele FIORE - ANSPI', pageWidth / 2, 15, { align: 'center' });
    doc.setFontSize(12);
    doc.setFont('helvetica', 'normal');
    doc.text('Report Settimanale Prenotazioni', pageWidth / 2, 25, { align: 'center' });
    y = 45;
    doc.setTextColor(50, 50, 50);
    doc.setFontSize(11);
    doc.setFont('helvetica', 'bold');
    doc.text('Periodo: ' + fmtData(mondayStr) + ' - ' + fmtData(sundayStr), margin, y);
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(10);
    doc.text('Totale eventi: ' + eventiSettimana.length, margin, y + 7);
    y += 20;
    doc.setDrawColor(116, 185, 255);
    doc.line(margin, y, pageWidth - margin, y);
    y += 10;

    function stampaSezione(titolo, colore, lista) {
        if (lista.length === 0) return;
        checkPage(20);
        doc.setFillColor(colore[0], colore[1], colore[2]);
        doc.rect(margin, y - 5, pageWidth - margin * 2, 10, 'F');
        doc.setTextColor(255, 255, 255);
        doc.setFontSize(11);
        doc.setFont('helvetica', 'bold');
        doc.text(titolo + ' (' + lista.length + ')', margin + 3, y + 2);
        y += 12;
        doc.setFillColor(240, 240, 240);
        doc.rect(margin, y - 4, pageWidth - margin * 2, 8, 'F');
        doc.setTextColor(80, 80, 80);
        doc.setFontSize(9);
        doc.setFont('helvetica', 'bold');
        doc.text('Data', margin + 2, y + 1);
        doc.text('Ora', margin + 30, y + 1);
        doc.text('Nome', margin + 50, y + 1);
        doc.text('Telefono', margin + 110, y + 1);
        y += 10;
        doc.setFont('helvetica', 'normal');
        lista.sort(function(a, b) { return a.data.localeCompare(b.data) || a.ora.localeCompare(b.ora); });
        lista.forEach(function(b, idx) {
            checkPage(8);
            if (idx % 2 === 0) { doc.setFillColor(250, 250, 250); doc.rect(margin, y - 4, pageWidth - margin * 2, 7, 'F'); }
            doc.setTextColor(50, 50, 50);
            doc.text(fmtData(b.data), margin + 2, y);
            doc.text(b.ora || '', margin + 30, y);
            doc.text(String(b.nome || '').substring(0, 30), margin + 50, y);
            doc.text(String(b.telefono || '').substring(0, 15), margin + 110, y);
            y += 8;
        });
        y += 5;
    }

    stampaSezione('Calcetto', [52, 152, 219], calcetto);
    stampaSezione('Pallavolo', [46, 204, 113], pallavolo);
    stampaSezione('Compleanni', [241, 196, 15], compleanni);
    stampaSezione('Eventi Straordinari', [231, 76, 60], eventi);

    if (eventiSettimana.length === 0) {
        doc.setTextColor(150, 150, 150);
        doc.setFontSize(12);
        doc.text('Nessun evento registrato per questa settimana.', pageWidth / 2, y + 20, { align: 'center' });
    }

    var pageCount = doc.internal.getNumberOfPages();
    for (var i = 1; i <= pageCount; i++) {
        doc.setPage(i);
        doc.setFontSize(8);
        doc.setTextColor(150, 150, 150);
        doc.text('Generato il ' + new Date().toLocaleString('it-IT') + ' - Pagina ' + i + ' di ' + pageCount,
            pageWidth / 2, 290, { align: 'center' });
    }
    var filename = 'Report_Settimana_' + weekInput.value.replace('-W', '_W') + '.pdf';
    doc.save(filename);
    showBanner('PDF generato con successo!', 'success');
}

// =====================
// CHECK INVISIBLE RECURRENCE
// =====================

function checkAndWarnInvisibleRecurrence(data, ora, campo, isAdmin) {
    if (campo !== 'calcetto' && campo !== 'pallavolo') {
        return Promise.resolve(false);
    }
    return makeRequest('checkInvisibleRecurrences', { data: data, ora: ora, campo: campo })
        .then(function(result) {
            if (!result || !result.conflict) return false;
            if (!isAdmin) {
                showBanner('Attenzione: in questa data potrebbe essere gia prevista ' +
                    'una partita di ' + result.evento + ' alle ' + result.ora + '. ' +
                    'Per prenotare contatta l\'amministratore.', 'error', 8000);
                return true;
            }
            return new Promise(function(resolve) {
                var modalContent = '<div class="confirm-modal-body">' +
                    '<p><strong>Attenzione:</strong> in questa data potrebbe essere prevista una partita ricorrente:</p>' +
                    '<ul style="margin: 12px 0 12px 20px; color: var(--text-light);">' +
                    '<li><strong>Evento:</strong> ' + result.evento + '</li>' +
                    '<li><strong>Campo:</strong> ' + result.campo + '</li>' +
                    '<li><strong>Ora:</strong> ' + result.ora + '</li>' +
                    '<li><strong>Prenotata da:</strong> ' + result.masterNome + '</li></ul>' +
                    '<p style="color: rgba(255,255,255,0.75); font-size: 0.9rem;">' +
                    'La ricorrenza non e ancora visibile ma e prevista automaticamente. ' +
                    'Se procedi, la prenotazione verra creata e la ricorrenza si spostera alla settimana successiva.' +
                    '</p></div>';
                renderModal('Possibile Conflitto Ricorrenza', modalContent,
                    function() { closeModal('confirmModal'); resolve(false); },
                    'Procedi comunque');
                var cancelBtn = document.getElementById('btn-cancel-final-booking');
                if (cancelBtn) {
                    var newCancelBtn = cancelBtn.cloneNode(true);
                    cancelBtn.parentNode.replaceChild(newCancelBtn, cancelBtn);
                    newCancelBtn.addEventListener('click', function() { closeModal('confirmModal'); resolve(true); });
                }
            });
        })
        .catch(function(e) {
            console.warn('checkInvisibleRecurrences fallito:', e.message);
            return false;
        });
}

