function updateStats() {
    var todayStr = new Date().toISOString().split("T")[0];
    var bookingsData = calendarBookings.length > 0 ? calendarBookings : bookings;
    document.getElementById("totalBookings").textContent = bookingsData.length;
    document.getElementById("todayBookings").textContent = bookingsData.filter(function(e) {
        return e.data.split('T')[0] === todayStr;
    }).length;
    var activeBookings = bookingsData.filter(function(e) {
        return new Date(e.data.split('T')[0]) >= new Date(todayStr);
    });
    document.getElementById("activeBookings").textContent = activeBookings.length;
    var startOfWeek = new Date();
    startOfWeek.setDate(startOfWeek.getDate() - (startOfWeek.getDay() + 6) % 7);
    var weekStartStr = startOfWeek.toISOString().split('T')[0];
    document.getElementById("weekBookings").textContent = activeBookings.filter(function(b) {
        return b.data.split('T')[0] >= weekStartStr;
    }).length;
}

function updateBookingsTable() {
    var tbody = document.getElementById("bookingsTableBody");
    var dataSource = calendarBookings.length > 0 ? calendarBookings : bookings;

    // Filtra solo calcetto e pallavolo, no virtuali no generati
    var normalEvents = dataSource.filter(function(b) {
        var isVirtual = b.id.includes('-V');
        var isGenerated = b.id.includes('-R');
        var isRelevantEvent = b.evento === 'calcetto' || b.evento === 'pallavolo';
        return !isVirtual && !isGenerated && isRelevantEvent;
    });

    // Ordina cronologicamente
    normalEvents.sort(function(a, b) {
        return new Date(a.data + 'T' + a.ora) - new Date(b.data + 'T' + b.ora);
    });

    // Raggruppa per nome (case-insensitive, trim)
    var gruppi = {};
    normalEvents.forEach(function(b) {
        var key = (b.nome || '').trim().toLowerCase();
        if (!gruppi[key]) gruppi[key] = { nome: (b.nome || '').trim(), prenotazioni: [] };
        gruppi[key].prenotazioni.push(b);
    });

    // Ordina i gruppi per la data della prima prenotazione
    var gruppiArray = Object.values(gruppi).sort(function(a, b) {
        var dateA = new Date(a.prenotazioni[0].data + 'T' + a.prenotazioni[0].ora);
        var dateB = new Date(b.prenotazioni[0].data + 'T' + b.prenotazioni[0].ora);
        return dateA - dateB;
    });

    var html = '';

    gruppiArray.forEach(function(gruppo) {
        var prima = gruppo.prenotazioni[0];
        var totale = gruppo.prenotazioni.length;
        var hasPiu = totale > 1;
        var nomeId = 'gruppo-' + prima.id.replace(/[^a-zA-Z0-9]/g, '_');

        // Riga principale (prima prenotazione cronologica)
        var fieldControl = '<select data-id="' + prima.id + '" class="admin-campo-select" style="color: black; border-radius: 5px; padding: 2px;">' +
            '<option value="calcetto" ' + (prima.campo === 'calcetto' ? 'selected' : '') + '>Calcetto</option>' +
            '<option value="pallavolo" ' + (prima.campo === 'pallavolo' ? 'selected' : '') + '>Pallavolo</option></select>';

        var recurringControl = '<input type="checkbox" data-id="' + prima.id + '" class="admin-ricorrente-check checkbox-large" ' + (prima.ricorrente ? 'checked' : '') + '>';

        var createdBy = prima.adminactionby ?
            '<span class="admin-creator" title="' + prima.adminactionby + '">&#x1F468;&#x200D;&#x1F4BC; ' + prima.adminactionby.split('@')[0] + '</span>' :
            '<span class="user-creator">&#x1F464; Utente</span>';

        var toggleIcon = hasPiu
            ? '<span class="gruppo-toggle" data-target="' + nomeId + '" style="cursor:pointer; margin-right:6px; font-size:0.85rem; color:#0e1012; user-select:none;">&#x25BA;</span>'
            : '<span style="display:inline-block; width:18px;"></span>';

        var contatore = hasPiu
            ? '<span style="background:rgba(0,0,0,0.25); color:#0e1012; border-radius:10px; padding:1px 7px; font-size:0.78rem; font-weight:700; margin-left:4px; background:#0e1012; color:white;">' + totale + '</span>'
            : '';

        html += '<tr class="gruppo-master-row" style="cursor:' + (hasPiu ? 'pointer' : 'default') + ';" ' + (hasPiu ? 'onclick="toggleGruppo(\'' + nomeId + '\', this)"' : '') + '>' +
            '<td>' + prima.id.replace('-V','') + '</td>' +
            '<td>' + toggleIcon + prima.nome + contatore + '</td>' +
            '<td>' + getEventName(prima.evento) + '</td>' +
            '<td>' + fieldControl + '</td>' +
            '<td>' + formatDate(prima.data) + '<br>' + prima.ora + '</td>' +
            '<td style="text-align:center">' + recurringControl + '</td>' +
            '<td>' + createdBy + '</td>' +
            '<td><button class="btn btn-danger admin-delete-btn" data-id="' + prima.id + '" style="padding:5px 10px;font-size:12px;width:auto;min-height:auto">&#x1F5D1;&#xFE0F;</button></td>' +
            '</tr>';

        // Righe espandibili (dalla seconda in poi)
        if (hasPiu) {
            html += '<tr id="' + nomeId + '" class="gruppo-espanso" style="display:none;">' +
                '<td colspan="8" style="padding: 0;">' +
                '<table style="width:100%; border-collapse:collapse; background:rgba(116,185,255,0.04);">';

            for (var i = 1; i < totale; i++) {
                var b = gruppo.prenotazioni[i];
                var fc = '<select data-id="' + b.id + '" class="admin-campo-select" style="color: black; border-radius: 5px; padding: 2px;">' +
                    '<option value="calcetto" ' + (b.campo === 'calcetto' ? 'selected' : '') + '>Calcetto</option>' +
                    '<option value="pallavolo" ' + (b.campo === 'pallavolo' ? 'selected' : '') + '>Pallavolo</option></select>';

                var rc = '<input type="checkbox" data-id="' + b.id + '" class="admin-ricorrente-check checkbox-large" ' + (b.ricorrente ? 'checked' : '') + '>';

                var cb = b.adminactionby ?
                    '<span class="admin-creator" title="' + b.adminactionby + '">&#x1F468;&#x200D;&#x1F4BC; ' + b.adminactionby.split('@')[0] + '</span>' :
                    '<span class="user-creator">&#x1F464; Utente</span>';

                html += '<tr style="border-top:1px solid rgba(255,255,255,0.07);">' +
                    '<td style="padding:8px 10px; font-size:0.88rem; color:rgba(255,255,255,0.55);">' + b.id.replace('-V','') + '</td>' +
                    '<td style="padding:8px 10px; font-size:0.88rem; color:rgba(255,255,255,0.7);">' +
                    '<span style="display:inline-block; width:18px;"></span>' +
                    '<span style="opacity:0.6;">&#x21B3;</span> ' + b.nome + '</td>' +
                    '<td style="padding:8px 10px;">' + getEventName(b.evento) + '</td>' +
                    '<td style="padding:8px 10px;">' + fc + '</td>' +
                    '<td style="padding:8px 10px; font-size:0.88rem;">' + formatDate(b.data) + '<br>' + b.ora + '</td>' +
