async function submitRangeModal(bookingId, dataInizio, dataFine) {
    if (!dataInizio || !dataFine) { showBanner('Inserisci data inizio e data fine', 'error'); return; }
    var giorniChecked = document.querySelectorAll('.range-giorno-check:checked');
    var giorniSettimana = [];
    giorniChecked.forEach(function(cb) { giorniSettimana.push(parseInt(cb.value)); });
    if (giorniSettimana.length === 0) { showBanner('Seleziona almeno un giorno della settimana', 'error'); return; }
    var allBookings = calendarBookings.length > 0 ? calendarBookings : bookings;
    var originalBooking = allBookings.find(function(b) { return b.id === bookingId || b.id === bookingId + '-V'; });
    if (!originalBooking) { showBanner('Prenotazione originale non trovata', 'error'); return; }
    window._rangeModalOpen = true;
    closeModal('details-modal');
    var checkboxEl = document.querySelector('.admin-ricorrente-check[data-id="' + bookingId + '"]');
    if (checkboxEl) checkboxEl.checked = true;
    try {
        var rangeResult = await makeRequest('createBookingRange', {
            dataInizio: dataInizio, dataFine: dataFine, giorniSettimana: giorniSettimana,
            booking: { nome: originalBooking.nome, email: originalBooking.email, telefono: originalBooking.telefono,
                evento: originalBooking.evento, campo: originalBooking.campo, ora: originalBooking.ora,
                note: originalBooking.note || '', ricorrente: false, adminActionBy: currentAdminEmail }
        });
        if (rangeResult.status === 'ok') {
            showBanner(rangeResult.message || 'Prenotazioni create con successo!', 'success');
            try { await makeRequest('updateBookingDetail', { bookingId: bookingId, field: 'ricorrente', value: true }); } catch(e) {}
            await loadInitialData(true);
        } else {
            showBanner('Errore: ' + rangeResult.message, 'error');
            if (checkboxEl) checkboxEl.checked = false;
        }
    } catch (error) {
        showBanner('Errore comunicazione server', 'error');
        if (checkboxEl) checkboxEl.checked = false;
    } finally {
        window._rangeModalOpen = false;
    }
}

