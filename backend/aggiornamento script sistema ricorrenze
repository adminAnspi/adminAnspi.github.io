function getArchivedEventsForDate(dateString) {
    if (!archivedBookings || !Array.isArray(archivedBookings)) return [];
    return archivedBookings.filter(function(b) {
        if (!b.data) return false;
        var eventDateStr = b.data.includes('T') ? b.data.split('T')[0] : b.data;
        var targetDateStr = dateString.includes('T') ? dateString.split('T')[0] : dateString;
        return eventDateStr === targetDateStr;
    });
}

function truncateEventName(name) {
    if (!name) return '';
    if (name.length > 15) {
        var firstWord = name.split(' ')[0];
        return firstWord.length > 15 ? firstWord.substring(0, 15) + '...' : firstWord;
    }
    return name;
}

function adjustColorBrightness(color, brightness) {
    if (color.startsWith('#')) {
        var hex = color.replace('#', '');
        var r = Math.round(parseInt(hex.substr(0, 2), 16) * brightness);
        var g = Math.round(parseInt(hex.substr(2, 2), 16) * brightness);
        var b = Math.round(parseInt(hex.substr(4, 2), 16) * brightness);
        return 'rgb(' + r + ', ' + g + ', ' + b + ')';
    }
    if (color.startsWith('rgb')) {
        var values = color.match(/\d+/g);
        if (values && values.length >= 3) {
            return 'rgb(' + Math.round(parseInt(values[0]) * brightness) + ', ' +
                Math.round(parseInt(values[1]) * brightness) + ', ' +
                Math.round(parseInt(values[2]) * brightness) + ')';
        }
    }
    return color;
}

function isDatePast(dateString) {
    var today = new Date();
    today.setHours(0, 0, 0, 0);
    var date = new Date(dateString + 'T00:00:00');
    return date < today;
}

