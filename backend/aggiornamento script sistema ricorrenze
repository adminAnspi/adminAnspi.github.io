async function _submitAdminBookingConSpazio(spazio) {
    var btn = document.getElementById('btn-admin-submit-booking');
    var form = document.getElementById('admin-new-booking');

    var temp = window._adminBookingTemp || {};
    var evento = temp.evento || document.getElementById('adminEvento').value;
    var isSpecialEvent = temp.isSpecialEvent !== undefined ? temp.isSpecialEvent : (evento === 'compleanno' || evento === 'eventi');
    var finalNote = temp.finalNote || '';
    var adminData = temp.adminData || document.getElementById('adminData').value;
    var adminOra = temp.adminOra || document.getElementById('adminOra').value;

    btn.classList.add('loading');
    btn.disabled = true;

    var campoValue = isSpecialEvent ? spazio : evento;

    var emailValue;
    var emailField = document.getElementById('adminEmail');
    if (isSpecialEvent && emailField && emailField.value.trim()) {
        emailValue = emailField.value.trim();
    } else {
        emailValue = 'prenotazionecampoanspi@gmail.com';
    }

    currentBooking = {
        id: 'ANSPI-' + generateShortId(),
        nome: document.getElementById('adminNome').value.trim(),
        email: emailValue,
        telefono: document.getElementById('adminTelefono').value.trim(),
        evento: evento,
        campo: campoValue,
        data: adminData,
        ora: adminOra,
        note: finalNote,
        ricorrente: false,
        adminActionBy: currentAdminEmail
    };

    // CHECK RICORRENZE INVISIBILI PER ADMIN
    if (evento === 'calcetto' || evento === 'pallavolo') {
        var blockedAdmin = await checkAndWarnInvisibleRecurrence(
            currentBooking.data,
            currentBooking.ora,
            currentBooking.campo,
            true
        );
        if (blockedAdmin) {
            btn.classList.remove('loading');
            btn.disabled = false;
            window._submitInProgress = false;
            return;
        }
    }

    // Gestione range date
    var isRangeBooking = document.getElementById('adminRicorrente') &&
                         document.getElementById('adminRicorrente').checked &&
                         (evento !== 'compleanno');
    if (isRangeBooking) {
        var dataInizio = document.getElementById('adminDataInizio').value;
        var dataFine = document.getElementById('adminDataFine').value;
        var giorniChecked = document.querySelectorAll('.giorno-check:checked');
        var giorniSettimana = [];
        giorniChecked.forEach(function(cb) {
            giorniSettimana.push(parseInt(cb.value));
        });

        if (!dataInizio || !dataFine) {
            showBanner('Inserisci data inizio e data fine per il range', 'error');
            btn.classList.remove('loading');
            btn.disabled = false;
            window._submitInProgress = false;
            return;
        }
        if (giorniSettimana.length === 0) {
            showBanner('Seleziona almeno un giorno della settimana', 'error');
            btn.classList.remove('loading');
            btn.disabled = false;
            window._submitInProgress = false;
            return;
        }

        try {
            var rangeResult = await makeRequest('createBookingRange', {
                dataInizio: dataInizio,
                dataFine: dataFine,
                giorniSettimana: giorniSettimana,
                booking: currentBooking
            });
            if (rangeResult.status === 'ok') {
                form.reset();
                toggleAdminCampoSelection();
                showBanner(rangeResult.message || 'Prenotazioni create con successo!', 'success');
                await loadInitialData(true);
            } else {
                showBanner('Errore: ' + rangeResult.message, 'error');
            }
        } catch (error) {
            showBanner('Errore comunicazione server', 'error');
        } finally {
            window._rangeModalOpen = true;
            btn.classList.remove('loading');
            btn.disabled = false;
            window._submitInProgress = false;
        }
        return;
    }
    // Pre-check conflitto basato su durata per admin
    try {
        var dayEvents = getEventsForDate(adminData);
        function toDate(ds, ts) { return new Date(ds + 'T' + ts + ':00'); }
        var reqStart = toDate(adminData, adminOra);
        var reqEnd = new Date(reqStart.getTime() + (DURATIONS[evento] || 90) * 60000);
        var overlaps = dayEvents.some(function(e) {
            var typeMatch = (e.evento === evento) || (e.campo === evento) || (e.campo === 'entrambi');
            if (!typeMatch || !e.ora) return false;
            var evStart = toDate(adminData, e.ora);
            var evEnd = new Date(evStart.getTime() + (DURATIONS[e.evento] || DURATIONS[evento] || 90) * 60000);
            return (reqStart < evEnd) && (evStart < reqEnd);
        });
        if (overlaps) {
            var isMaster = currentAdminEmail && currentAdminEmail.toLowerCase() === 'prenotazionecampoanspi@gmail.com';
            if (isMaster) {
                showGenericConfirmModal(
                    'Conflitto Rilevato',
                    'Esiste gia una prenotazione in questo orario. Vuoi procedere comunque?',
                    async function() {
                        try {
                            var bookingWithForce = Object.assign({}, currentBooking, { forceBooking: true });
                            var result = await makeRequest('createBooking', bookingWithForce);
                            if (result.status === 'ok' || result.status === 'updated') {
                                form.reset();
                                toggleAdminCampoSelection();
                                showBanner('Prenotazione creata con conflitto forzato!', 'success');
                                await loadInitialData(true);
                            } else {
                                showBanner('Errore: ' + result.message, 'error');
                            }
                        } catch(e) {
                            showBanner('Errore di comunicazione', 'error');
                        } finally {
                            btn.classList.remove('loading');
                            btn.disabled = false;
                            window._submitInProgress = false;
                        }
                    }
                );
                return;
            } else {
                showBanner('Conflitto rilevato: propongo alternative...', 'info', 4000);
                await finalConfirmBooking('admin');
                btn.classList.remove('loading');
                btn.disabled = false;
                window._submitInProgress = false;
                return;
            }
        }
    } catch (preErr) { /* empty */ }

    try {
        var result = await makeRequest('createBooking', currentBooking);
        if (result.status === 'exclusive_conflict') {
            showExclusiveConflictModal(result);
        } else if (result.status === 'conflict_suggestions') {
            showConflictModal(result, 'admin');
        } else if (result.status === 'ok') {
            form.reset();
            toggleAdminCampoSelection();
            showBanner('Prenotazione ' + (currentBooking.ricorrente ? 'ricorrente ' : '') + 'creata!', 'success');
            await loadInitialData(true);
        } else if (result.status === 'updated') {
            form.reset();
            toggleAdminCampoSelection();
            showBanner('Prenotazione aggiornata con successo!', 'success');
            await loadInitialData(true);
        } else if (result.status === 'duplicate') {
            showBanner('Esiste gia una prenotazione per questa data, ora e campo.', 'error');
        } else if (result.status === 'error') {
            showBanner('Errore: ' + result.message, 'error');
        } else {
            showBanner('Risposta inattesa dal server: ' + result.status, 'error');
        }
    } catch (error) {
        console.error('Creazione prenotazione admin fallita:', error);
        try {
            var verify = await makeRequest('getBookingsForCalendar');
            if (verify.status === 'ok') {
                var exists = (verify.data && verify.data.bookings || []).some(function(b) {
                    return String(b.id).trim() === String(currentBooking.id).trim();
                });
                if (exists) {
                    showBanner('Prenotazione registrata, ma la connessione ha dato errore. Aggiorna se non la vedi.', 'success');
                    await loadInitialData(true);
                } else {
                    showBanner('Errore di comunicazione con il server', 'error');
                }
            } else {
                showBanner('Errore di comunicazione con il server', 'error');
            }
        } catch (verifyError) {
            showBanner('Errore di comunicazione con il server', 'error');
        }
    } finally {
        window._submitInProgress = false;
        btn.classList.remove('loading');
        btn.disabled = false;
    }
}

