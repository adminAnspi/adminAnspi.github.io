                    '<td style="padding:8px 10px;">' + cb + '</td>' +
                    '<td style="padding:8px 10px;"><button class="btn btn-danger admin-delete-btn" data-id="' + b.id + '" style="padding:5px 10px;font-size:12px;width:auto;min-height:auto">&#x1F5D1;&#xFE0F;</button></td>' +
                    '</tr>';
            }

            html += '</table></td></tr>';
        }
    });

    tbody.innerHTML = html;
}

