<script> 
// =====================
// COSTANTI CLIENT-SIDE 
// =====================
var ICONS = {
    calcetto: '⚽',
    pallavolo: '🏐',
    compleanno: '🎉',
    eventi: '🎪',
    cliente: '👤',
    email: '📧',
    telefono: '📞',
    evento: '🎯',
    campo: '🏟️',
    data: '📅',
    ora: '🕐',
    note: '📝',
    codice: '🔐',
    timestamp: '🕒'
};

var EVENT_TYPES = {
    calcetto: { name: 'Calcetto', icon: '⚽', color: 'var(--primary-soft)' },
    pallavolo: { name: 'Volley', icon: '🏐', color: 'var(--success-soft)' },
    compleanno: { name: 'Compleanno', icon: '🎉', color: 'var(--warning-soft)' },
    eventi: { name: 'Evento Straordinario', icon: '🎪', color: 'var(--danger-soft)' }
};

var AVAILABILITY_ICONS = {
    available: '🟢',
    partial: '🟡',
    occupied: '🔴',
    special: '🔵',
    past: '⚫',
    closed: '🚪'
};

var DURATIONS = { calcetto: 90, pallavolo: 120, compleanno: 180, eventi: 180 };

async function loadDurations() {
    try {
        var resp = await makeRequest('getDurationMap');
        if (resp && resp.status === 'ok' && resp.data && resp.data.durationMap) {
            DURATIONS = resp.data.durationMap;
            console.log('Durate caricate dal backend:', DURATIONS);
        }
    } catch (e) { /* empty */ }
}

function getEventName(type) {
    return EVENT_TYPES[type] ? EVENT_TYPES[type].icon + ' ' + EVENT_TYPES[type].name : type;
}

function getShortEventName(type) {
    return EVENT_TYPES[type] ? EVENT_TYPES[type].name : type;
}

function getEventColor(type) {
    return EVENT_TYPES[type] ? EVENT_TYPES[type].color : 'var(--secondary-soft)';
}

function getAvailabilityIcon(status) {
    return AVAILABILITY_ICONS[status] || '⚪';
}

function getCampoName(type) {
    var nomi = {
        calcetto: 'Calcetto',
        pallavolo: 'Pallavolo',
        entrambi: 'Entrambi',
        salone_melone: 'Salone Melone',
        calcetto_salone: 'Calcetto + Salone',
        pallavolo_salone: 'Pallavolo + Salone',
        tutto: 'Tutti gli Spazi',
        'admin-managed': 'Da definire'
    };
    return nomi[type] || type;
}

var $elCache = {};
function el(id) {
    var cached = $elCache[id];
    if (cached && document.contains(cached)) return cached;
    var node = document.getElementById(id);
    $elCache[id] = node;
    return node;
}

var bookings = [],
    calendarBookings = [],
    selectedEvent = '',
    currentBooking = {},
    isAdminLoggedIn = false;
    currentStatusFilter = 'tutti';
var currentAdminEmail = '';
var calendarDate = new Date();
var archivedBookings = [],
    archiveCalendarDate = new Date();
var passwordTimeout = null;
var cache = {
    bookings: null,
    timestamp: null,
    duration: 30000
};

window.onload = initializeApp;

function initializeApp() {
    if (typeof google !== 'undefined' && google.script && google.script.run) {
        console.log("Google Script API ready.");
        var today = new Date();
        loadDurations().catch(function(){});
        document.getElementById('data').setAttribute('min', today.toISOString().split('T')[0]);
        document.getElementById('adminData').setAttribute('min', today.toISOString().split('T')[0]);
        setupEventListeners();
        loadInitialData();
        resetForm();
        injectCheckboxCSS();
        checkForResetToken();
        setupSmartRecurringListeners();
        
        makeRequest('getAppVersion').then(function(r) {
            if (r && r.status === 'ok') {
                var versionEl = document.getElementById('app-version-footer');
                if (versionEl) versionEl.textContent = 'v.' + r.data.version;
            }
        }).catch(function() {});
        
        hideMobileLoading();
    } else {
        if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
            console.log('Local preview mode');
            try {
                var today = new Date();
                var adminDate = document.getElementById('adminData');
                if (adminDate) adminDate.setAttribute('min', today.toISOString().split('T')[0]);
                setupEventListeners();
                resetForm();
                injectCheckboxCSS();
                hideMobileLoading();
                showAdminTab('new-booking');
            } catch (e) {
                console.warn('Local preview init warning:', e.message);
            }
        } else {
            setTimeout(initializeApp, 150);
        }
    }
}

function hideMobileLoading() {
    var loadingScreen = document.getElementById('mobileLoading');
    if (loadingScreen) {
        setTimeout(function() {
            loadingScreen.classList.add('hidden');
            setTimeout(function() {
                loadingScreen.style.display = 'none';
            }, 300);
        }, 500);
    }
}

function showMobileLoading() {
    var loadingScreen = document.getElementById('mobileLoading');
    if (loadingScreen) {
        loadingScreen.style.display = 'flex';
        loadingScreen.classList.remove('hidden');
    }
}

function updateStatus(message, online) {
    var indicator = document.getElementById('statusIndicator');
    indicator.textContent = online ? '🟢 ' + message : '🔴 ' + message;
    indicator.className = 'status-indicator ' + (online ? '' : 'offline');
}

function setupEventListeners() {
    document.getElementById('event-calcetto').addEventListener('click', function() { selectEvent('calcetto'); });
    document.getElementById('event-pallavolo').addEventListener('click', function() { selectEvent('pallavolo'); });
    document.getElementById('event-compleanno').addEventListener('click', function() { selectEvent('compleanno'); });
    document.getElementById('event-eventi').addEventListener('click', function() { selectEvent('eventi'); });
    document.getElementById('btn-back').addEventListener('click', resetForm);
    document.getElementById('btn-submit-booking').addEventListener('click', submitBooking);
    document.getElementById('btn-cancel-booking').addEventListener('click', cancelBooking);
    document.getElementById('btn-admin-login').addEventListener('click', adminLogin);
    document.getElementById('btn-admin-exit').addEventListener('click', exitAdminPanel);
    document.getElementById('btn-refresh-data').addEventListener('click', refreshData);
    
    document.getElementById('prevArchiveMonthBtn').addEventListener('click', function() {
        var currentMonth = archiveCalendarDate.getMonth();
        var currentYear = archiveCalendarDate.getFullYear();
        archiveCalendarDate = new Date(currentYear, currentMonth - 1, 1);
        renderArchivedMonthlyCalendar();
    });
    document.getElementById('nextArchiveMonthBtn').addEventListener('click', function() {
        var currentMonth = archiveCalendarDate.getMonth();
        var currentYear = archiveCalendarDate.getFullYear();
        archiveCalendarDate = new Date(currentYear, currentMonth + 1, 1);
        renderArchivedMonthlyCalendar();
    });
    
    var testArchiveBtn = document.getElementById('btn-test-archive');
    if (testArchiveBtn) testArchiveBtn.addEventListener('click', testArchive);

    var manualArchiveBtn = document.getElementById('btn-manual-archive');
    if (manualArchiveBtn) manualArchiveBtn.addEventListener('click', manualArchive);

    document.getElementById('admin-tabs-container').addEventListener('click', async function(event) {
        if (event.target.classList.contains('admin-tab') && event.target.dataset.tab) {
            await showAdminTab(event.target.dataset.tab);
        }
    });
    
    document.getElementById('adminEvento').addEventListener('change', toggleAdminCampoSelection);
    document.getElementById('btn-admin-submit-booking').addEventListener('click', submitAdminBooking);
    
    document.getElementById('prevMonthBtn').addEventListener('click', function() {
        var currentMonth = calendarDate.getMonth();
        var currentYear = calendarDate.getFullYear();
        calendarDate = new Date(currentYear, currentMonth - 1, 1);
        renderMonthlyCalendar();
    });
    document.getElementById('nextMonthBtn').addEventListener('click', function() {
        var currentMonth = calendarDate.getMonth();
        var currentYear = calendarDate.getFullYear();
        calendarDate = new Date(currentYear, currentMonth + 1, 1);
        renderMonthlyCalendar();
    });
    document.getElementById('prevWeekBtn').addEventListener('click', function() {
        calendarDate.setDate(calendarDate.getDate() - 7);
        renderWeeklyCalendar();
    });
    document.getElementById('nextWeekBtn').addEventListener('click', function() {
        calendarDate.setDate(calendarDate.getDate() + 7);
        renderWeeklyCalendar();
    });
    document.getElementById('btn-view-monthly').addEventListener('click', function() { toggleCalendarView('monthly'); });
    document.getElementById('btn-view-weekly').addEventListener('click', function() { toggleCalendarView('weekly'); });
    document.getElementById('close-confirm-modal').addEventListener('click', function() { closeModal('confirmModal'); });
    document.getElementById('btn-cancel-final-booking').addEventListener('click', function() { closeModal('confirmModal'); });
    document.getElementById('close-details-modal').addEventListener('click', function() {
        window._spazioSelezionato = null;
        window._rangeModalOpen = false;
        closeModal('details-modal');
    });
    
    document.getElementById('calendarDays').addEventListener('click', function(e) {
        var dayCell = e.target.closest('.calendar-day');
        if (dayCell) {
            var dateString = dayCell.dataset.date;
            if (!dateString) return;
            var eventsForDay = getEventsForDate(dateString);
            if (eventsForDay.length > 0 && !e.target.closest('.monthly-event-bar')) {
                showDaySummaryModal(dateString, eventsForDay);
            }
        }
    });
    
    document.getElementById('password-toggle').addEventListener('click', togglePasswordVisibility);
    document.getElementById('loginPassword').addEventListener('input', handlePasswordInput);
    
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            window._spazioSelezionato = null;
            window._rangeModalOpen = false;
            document.querySelectorAll('.modal').forEach(function(m) { m.style.display = 'none'; });
        }
    });
    
    document.querySelector('.status-filters').addEventListener('click', function(e) {
        if (e.target.classList.contains('filter-btn')) {
            var filter = e.target.dataset.filter;
            setStatusFilter(filter);
        }
    });

    // =====================
    // LISTENER TABELLA EVENTI SPECIALI
    // =====================
    var eventiSpecialiTbody = document.getElementById("eventiSpecialiTableBody");
    if (eventiSpecialiTbody) {
        eventiSpecialiTbody.addEventListener('click', function(e) {
            var button = e.target.closest('button');
            if (!button) return;
            var bookingId = button.dataset.id;
            if (button.classList.contains('approve-btn')) approveEvent(bookingId);
            else if (button.classList.contains('reject-btn')) rejectEvent(bookingId);
            else if (button.classList.contains('admin-delete-btn')) deleteBooking(bookingId);
        });

        eventiSpecialiTbody.addEventListener('change', function(e) {
            if (e.target.classList.contains('admin-ricorrente-check')) {
                if (e.target.checked) {
                    var bookingId = e.target.dataset.id;
                    var checkbox = e.target;
                    checkbox.checked = false;
                    showRangeModal(bookingId, checkbox);
                } else {
                    if (window._rangeModalOpen) {
                        window._rangeModalOpen = false;
                        return;
                    }
                    var bookingId = e.target.dataset.id;
                    var checkbox = e.target;
                    var allBookings = calendarBookings.length > 0 ? calendarBookings : bookings;
                    var originalBooking = allBookings.find(function(b) { return b.id === bookingId; });
                    if (!originalBooking) {
                        updateRecurring(bookingId, checkbox);
                        return;
                    }
                    showGenericConfirmModal(
                        'Elimina Ricorrenze',
                        'Vuoi eliminare tutte le prenotazioni future di ' + originalBooking.nome + ' (' + originalBooking.evento + ' alle ' + originalBooking.ora + ')?',
                        async function() {
                            try {
                                var result = await makeRequest('deleteRangeBookings', {
                                    nome: originalBooking.nome,
                                    evento: originalBooking.evento,
                                    ora: originalBooking.ora,
                                    campo: originalBooking.campo,
                                    dataFrom: new Date().toISOString().split('T')[0]
                                });
                                await makeRequest('updateBookingDetail', {
                                    bookingId: bookingId,
                                    field: 'ricorrente',
                                    value: false
                                });
                                showBanner(result.message || 'Ricorrenze eliminate', 'success');
                                await loadInitialData(true);
                            } catch(e) {
                                showBanner('Errore eliminazione ricorrenze', 'error');
                            }
                        }
                    );
                }
            }
        });
    }

    // =====================
    // LISTENER TABELLA PRENOTAZIONI
    // =====================
    var bookingsTbody = document.getElementById("bookingsTableBody");
    if (bookingsTbody) {
        bookingsTbody.addEventListener('click', function(e) {
            if (e.target.classList.contains('admin-delete-btn')) deleteBooking(e.target.dataset.id);
        });
        bookingsTbody.addEventListener('change', function(e) {
            if (e.target.classList.contains('admin-ricorrente-check')) {
                if (e.target.checked) {
                    var bookingId = e.target.dataset.id;
                    var checkbox = e.target;
                    checkbox.checked = false;
                    showRangeModal(bookingId, checkbox);
                } else {
                    if (window._rangeModalOpen) {
                        window._rangeModalOpen = false;
                        return;
                    }
                    var bookingId = e.target.dataset.id;
                    var checkbox = e.target;
                    var allBookings = calendarBookings.length > 0 ? calendarBookings : bookings;
                    var originalBooking = allBookings.find(function(b) { return b.id === bookingId; });
                    if (!originalBooking) {
                        updateRecurring(bookingId, checkbox);
                        return;
                    }
                    var checkboxElDel = document.querySelector('.admin-ricorrente-check[data-id="' + bookingId + '"]');
                    if (checkboxElDel) checkboxElDel.checked = false;
                    showGenericConfirmModal(
                        'Elimina Ricorrenze',
                        'Vuoi eliminare tutte le prenotazioni future di ' + originalBooking.nome + ' (' + originalBooking.evento + ' alle ' + originalBooking.ora + ')?',
                        async function() {
                            try {
                                var result = await makeRequest('deleteRangeBookings', {
                                    nome: originalBooking.nome,
                                    evento: originalBooking.evento,
                                    ora: originalBooking.ora,
                                    campo: originalBooking.campo,
                                    dataFrom: new Date().toISOString().split('T')[0]
                                });
                                await makeRequest('updateBookingDetail', {
                                    bookingId: bookingId,
                                    field: 'ricorrente',
                                    value: false
                                });
                                showBanner(result.message || 'Ricorrenze eliminate', 'success');
                                await loadInitialData(true);
                            } catch(e) {
                                showBanner('Errore eliminazione ricorrenze', 'error');
                            }
                        }
                    );
                }
            }
            if (e.target.classList.contains('admin-campo-select')) updateField(e.target.dataset.id, e.target);
        });
    }

    var closeArchiveModal = document.getElementById('close-archive-modal');
    if (closeArchiveModal) {
        closeArchiveModal.addEventListener('click', function() { closeModal('archiveModal'); });
    }

    var testDateMathBtn = document.getElementById('btn-test-date-math');
    if (testDateMathBtn) testDateMathBtn.addEventListener('click', testDateMathBtnClick);

    var btnAddAdmin = document.getElementById('btn-add-admin');
    if (btnAddAdmin) btnAddAdmin.addEventListener('click', addNewAdminHandler);

    var btnResetPassword = document.getElementById('btn-reset-password');
    if (btnResetPassword) btnResetPassword.addEventListener('click', resetAdminPasswordHandler);

    var btnRemoveAdmin = document.getElementById('btn-remove-admin');
    if (btnRemoveAdmin) btnRemoveAdmin.addEventListener('click', removeAdminHandler);

    document.addEventListener('DOMContentLoaded', function() {
        if (document.getElementById('publicCalendar')) {
            setupPublicCalendarListeners();
        }
    });
}

function setupCalendarDoubleClick() {
    var calendarDays = document.getElementById('calendarDays');
    if (calendarDays) {
        calendarDays.addEventListener('dblclick', function(e) {
            if (!isAdminLoggedIn) {
                showBanner('Solo gli admin possono creare eventi dal calendario', 'warning');
                return;
            }
            var dayCell = e.target.closest('.calendar-day');
            if (!dayCell || dayCell.classList.contains('other-month')) return;
            var dateString = dayCell.dataset.date;
            if (!dateString) return;
            if (e.target.closest('.monthly-event-bar')) return;
            openQuickBookingForm(dateString);
        });
    }
}

function addCalendarTooltips() {
    console.log('Tooltip calendario inizializzati');
}

function openQuickBookingForm(dateString) {
    showAdminTab('new-booking');
    var adminDataInput = document.getElementById('adminData');
    if (adminDataInput) adminDataInput.value = dateString;
    var adminNomeInput = document.getElementById('adminNome');
    if (adminNomeInput) adminNomeInput.focus();
    showBanner('Nuova prenotazione per ' + formatDate(dateString), 'info', 3000);
}

function showPasswordResetForm() {
    var email = document.getElementById('loginEmail').value;
    if (!email) {
        showBanner('Inserisci prima la tua email amministratore', 'error');
        return;
    }
    var modal = document.getElementById('resetPasswordModal');
    var title = document.getElementById('resetModalTitle');
    var content = document.getElementById('resetContent');
    var footer = document.getElementById('resetFooter');
    title.textContent = 'Richiesta Reset Password';
    content.innerHTML = '<p>Inserisci la tua email da amministratore.</p>' +
        '<div class="form-group" style="margin-top: 20px;">' +
        '<label for="reset-email">Email Amministratore</label>' +
        '<input type="email" id="reset-email" class="form-group input" value="' + email + '" required></div>';
    footer.innerHTML = '<button class="btn btn-danger" onclick="closeModal(\'resetPasswordModal\')">Annulla</button>' +
        '<button class="btn" id="btn-send-reset-link">Invia Link</button>';
    modal.style.display = 'block';
    document.getElementById('btn-send-reset-link').onclick = async function() {
        var emailVal = document.getElementById('reset-email').value;
        if (!emailVal) {
            showBanner('Inserisci un indirizzo email', 'error');
            return;
        }
        try {
            var result = await makeRequest('requestPasswordReset', { email: emailVal });
            showBanner(result.message, 'success');
            closeModal('resetPasswordModal');
        } catch (error) { /* gestito da makeRequest */ }
    };
}

function checkForResetToken() {
    var token = serverData.resetToken;
    if (token) {
        history.pushState(null, "", window.location.pathname);
        var modal = document.getElementById('resetPasswordModal');
        var title = document.getElementById('resetModalTitle');
        var content = document.getElementById('resetContent');
        var footer = document.getElementById('resetFooter');
        title.textContent = 'Imposta Nuova Password';
        content.innerHTML = '<p>Inserisci la tua nuova password.</p>' +
            '<div class="form-group" style="margin-top: 15px;">' +
            '<label for="new-reset-password">Nuova Password (almeno 6 caratteri)</label>' +
            '<input type="password" id="new-reset-password" class="form-group input" required></div>' +
            '<div class="form-group">' +
            '<label for="confirm-reset-password">Conferma Nuova Password</label>' +
            '<input type="password" id="confirm-reset-password" class="form-group input" required></div>';
        footer.innerHTML = '<button class="btn btn-danger" onclick="closeModal(\'resetPasswordModal\')">Annulla</button>' +
            '<button class="btn" id="btn-save-new-password">Salva Password</button>';
        modal.style.display = 'block';
        document.getElementById('btn-save-new-password').onclick = async function() {
            var newPassword = document.getElementById('new-reset-password').value;
            var confirmPassword = document.getElementById('confirm-reset-password').value;
            if (newPassword.length < 6) {
                showBanner('La password deve essere di almeno 6 caratteri', 'error');
                return;
            }
            if (newPassword !== confirmPassword) {
                showBanner('Le password non coincidono', 'error');
                return;
            }
            try {
                var result = await makeRequest('performPasswordReset', { token: token, newPassword: newPassword });
                showBanner(result.message, 'success');
                closeModal('resetPasswordModal');
            } catch (error) { /* gestito da makeRequest */ }
        };
    }
}

function injectCheckboxCSS() {
    var checkboxCSS = '.checkbox-large { width: 20px !important; height: 20px !important; cursor: pointer; accent-color: #74b9ff; transform: scale(1.3); margin-right: 8px; }' +
        '.checkbox-container { display: flex; align-items: center; gap: 10px; margin: 12px 0; padding: 12px; background: rgba(116, 185, 255, 0.08); border-radius: 8px; border: 1px solid rgba(116, 185, 255, 0.2); }' +
        '.checkbox-label { font-weight: 600; cursor: pointer; user-select: none; font-size: 0.95rem; }' +
        '.checkbox-container:hover { background: rgba(116, 185, 255, 0.12); border-color: rgba(116, 185, 255, 0.3); }';
    var style = document.createElement('style');
    style.textContent = checkboxCSS;
    document.head.appendChild(style);
}

function setStatusFilter(filter) {
    currentStatusFilter = filter;
    document.querySelectorAll('.filter-btn').forEach(function(btn) { btn.classList.remove('active'); });
    var targetBtn = document.querySelector('.filter-btn[data-filter="' + filter + '"]');
    if (targetBtn) targetBtn.classList.add('active');
    updateEventiSpecialiTable();
}

async function updateEventStats() {
    try {
        var result = await makeRequest('getEventStats');
        var stats = result.data.statusCounts;
        var statElements = {
            'stat-tutti': stats.tutti,
            'stat-in_attesa': stats.in_attesa,
            'stat-approvato': stats.approvato,
            'stat-rifiutato': stats.rifiutato
        };
        Object.entries(statElements).forEach(function(entry) {
            var element = document.getElementById(entry[0]);
            if (element) element.textContent = entry[1];
        });
    } catch (error) {
        console.error("Impossibile caricare le statistiche degli eventi:", error);
    }
}

function togglePasswordVisibility() {
    var passwordField = document.getElementById('loginPassword');
    var toggleBtn = document.getElementById('password-toggle');
    if (passwordField.type === 'password') {
        passwordField.type = 'text';
        toggleBtn.textContent = '🙈';
        toggleBtn.title = 'Nascondi password';
    } else {
        passwordField.type = 'password';
        toggleBtn.textContent = '👁️';
        toggleBtn.title = 'Mostra password';
    }
}

function handlePasswordInput() {
    var passwordField = document.getElementById('loginPassword');
    var toggleBtn = document.getElementById('password-toggle');
    passwordField.type = 'text';
    toggleBtn.textContent = '🙈';
    if (passwordTimeout) clearTimeout(passwordTimeout);
    passwordTimeout = setTimeout(function() {
        if (passwordField.type === 'text') {
            passwordField.type = 'password';
            toggleBtn.textContent = '👁️';
            toggleBtn.title = 'Mostra password';
        }
    }, 2000);
}

function toggleAdminCampoSelection() {
    var evento = document.getElementById('adminEvento') ? document.getElementById('adminEvento').value : '';
    var emailGroup = document.getElementById('adminEmailGroup');
    var emailField = document.getElementById('adminEmail');
    var recurringGroup = document.getElementById('adminRecurringGroup');
    var confirmGroup = document.getElementById('adminConfirmGroup');
    var adminNoteGroup = document.getElementById('admin-note-group');
    var adminExclusiveDetails = document.getElementById('admin-exclusive-event-details');
    var adminPersonCount = document.getElementById('admin-person-count');
    var isSpecialEvent = evento === 'compleanno' || evento === 'eventi';

    if (window._ultimoEventoAdmin !== evento) {
        window._spazioSelezionato = null;
        window._ultimoEventoAdmin = evento;
    }

    if (isSpecialEvent) {
        if (emailGroup) emailGroup.style.display = 'block';
        if (emailField) emailField.required = true;
        if (confirmGroup) confirmGroup.style.display = 'block';
        if (adminNoteGroup) adminNoteGroup.style.display = 'none';
        if (adminExclusiveDetails) adminExclusiveDetails.style.display = 'block';
        if (adminPersonCount) adminPersonCount.required = true;

        if (evento === 'compleanno') {
            if (recurringGroup) recurringGroup.style.display = 'none';
            var ricorrenteField = document.getElementById('adminRicorrente');
            if (ricorrenteField) ricorrenteField.checked = false;
            var rangeGroup = document.getElementById('adminRangeGroup');
            if (rangeGroup) rangeGroup.style.display = 'none';
        } else {
            // eventi straordinari — mostra checkbox ricorrente con range
            if (recurringGroup) recurringGroup.style.display = 'block';
            var ricorrenteCheck2 = document.getElementById('adminRicorrente');
            if (ricorrenteCheck2) {
                ricorrenteCheck2.onchange = function() {
                    var rangeGroup = document.getElementById('adminRangeGroup');
                    if (rangeGroup) {
                        rangeGroup.style.display = this.checked ? 'block' : 'none';
                    }
                };
            }
        }

        if (!window._spazioSelezionato) {
            showSpazioModal(function(spazio) {
                window._spazioSelezionato = spazio;
                var spazioLabel = document.getElementById('admin-spazio-label');
                if (spazioLabel) {
                    spazioLabel.textContent = 'Spazio selezionato: ' + getCampoName(spazio);
                    spazioLabel.style.display = 'block';
                }
            });
        }

    } else {
        if (emailGroup) emailGroup.style.display = 'none';
        if (emailField) {
            emailField.required = false;
            emailField.value = '';
        }
        if (recurringGroup) recurringGroup.style.display = 'block';
        var ricorrenteCheck = document.getElementById('adminRicorrente');
        if (ricorrenteCheck) {
            ricorrenteCheck.onchange = function() {
                var rangeGroup = document.getElementById('adminRangeGroup');
                if (rangeGroup) {
                    rangeGroup.style.display = this.checked ? 'block' : 'none';
                }
            };
        }
        if (confirmGroup) {
