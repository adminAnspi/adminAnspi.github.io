}

function showConflictModal(response, formContext) {
    if (formContext === undefined) formContext = 'user';
    var modal = el('conflictModal');
    var content = el('conflictContent');
    var closeBtn = el('close-conflict-modal-btn');

    var conflictHtml = '<p style="line-height: 1.6; color: var(--text-light);">L\'orario scelto e gia occupato da una prenotazione per <strong>' +
        getEventName(response.conflictDetails.evento) + '</strong> delle ore <strong>' + response.conflictDetails.ora + '</strong>.</p>';

    var hasSuggestions = response.suggestions.before || response.suggestions.after;
    if (hasSuggestions) {
        conflictHtml += '<p style="margin-top: 20px; font-weight: 600; color: var(--text-warm);">Potresti provare uno di questi orari alternativi:</p>';
    } else {
        conflictHtml += '<p style="margin-top: 20px; font-weight: 600; color: var(--text-warm);">Non sono stati trovati slot alternativi disponibili.</p>';
    }
    conflictHtml += '<div style="margin-top: 15px; display: flex; flex-direction: column; gap: 10px;">';
    if (response.suggestions.before) {
        conflictHtml += '<button class="btn suggestion-btn" data-time="' + response.suggestions.before + '">Prova alle ' + response.suggestions.before + ' (prima)</button>';
    }
    if (response.suggestions.after) {
        conflictHtml += '<button class="btn suggestion-btn" data-time="' + response.suggestions.after + '">Prova alle ' + response.suggestions.after + ' (dopo)</button>';
    }
    conflictHtml += '</div>';
    conflictHtml += '<div style="margin-top: 24px; border-top: 1px solid #eee; padding-top: 16px; display: flex; justify-content: flex-end;">';
    conflictHtml += '<button id="close-suggestion-modal" class="btn btn-danger">Chiudi</button>';
    conflictHtml += '</div>';
    content.innerHTML = conflictHtml;
    modal.style.display = 'block';

    var closeModalFunc = function() { modal.style.display = 'none'; };
    closeBtn.onclick = closeModalFunc;
    el('close-suggestion-modal').onclick = function() { closeModalFunc(); resetForm(); };

    document.querySelectorAll('.suggestion-btn').forEach(function(button) {
        button.onclick = function() {
            var newTime = button.getAttribute('data-time');
            var oraInputId = formContext === 'admin' ? 'adminOra' : 'ora';
            el(oraInputId).value = newTime;
            currentBooking.ora = newTime;
            closeModalFunc();
            showBanner('Orario aggiornato alle ' + newTime + '. Controlla e conferma di nuovo.', 'success', 5000);
            if (formContext === 'admin') {
                submitAdminBooking(null, true);
            } else {
                showConfirmModal(currentBooking, function() { finalConfirmBooking('user'); });
            }
        };
    });

    window.onclick = function(event) {
        if (event.target == modal) closeModalFunc();
    };
}

async function cancelBooking() {
    var code = document.getElementById('cancelCode').value.trim();
    if (!code) {
        showBanner('Inserisci il codice', 'error');
        return;
    }
    showGenericConfirmModal('Conferma Cancellazione', 'Sei sicuro di voler cancellare la prenotazione ' + code + '?', async function() {
        try {
            await makeRequest('cancelBooking', { bookingId: code });
            document.getElementById('cancelCode').value = '';
            showBanner('Prenotazione cancellata', 'success');
            await loadInitialData(true);
        } catch (error) { /* empty */ }
