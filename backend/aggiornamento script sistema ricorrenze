function setupBookingSearch() {
    var input = document.getElementById('searchNomeInput');
    var suggestionsBox = document.getElementById('searchNomeSuggestions');
    var resultsDiv = document.getElementById('searchResults');
    var btnCerca = document.getElementById('btnCercaNome');
    var btnClear = document.getElementById('btnClearSearch');
 
    if (!input) return;
 
    var searchTimeout = null;
 
    input.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        var val = input.value.trim();
        if (val.length < 2) { suggestionsBox.style.display = 'none'; return; }
        searchTimeout = setTimeout(function() {
            makeRequest('searchBookingsByName', { query: val }).then(function(r) {
                if (r.status !== 'ok' || !r.data.names.length) {
                    suggestionsBox.style.display = 'none';
                    return;
                }
                suggestionsBox.innerHTML = r.data.names.map(function(name) {
                    return '<div class="search-suggestion-item" style="padding: 10px 14px; cursor: pointer; color: white; border-bottom: 1px solid rgba(255,255,255,0.08);">' + name + '</div>';
                }).join('');
                suggestionsBox.style.display = 'block';
                suggestionsBox.querySelectorAll('.search-suggestion-item').forEach(function(item) {
                    item.addEventListener('click', function() {
                        input.value = item.textContent;
                        suggestionsBox.style.display = 'none';
                        eseguiRicerca(item.textContent);
                    });
                    item.addEventListener('mouseenter', function() { item.style.background = 'rgba(116,185,255,0.15)'; });
                    item.addEventListener('mouseleave', function() { item.style.background = ''; });
                });
            }).catch(function() {});
        }, 300);
    });
 
    btnCerca.addEventListener('click', function() {
        var val = input.value.trim();
        if (val.length < 2) { showBanner('Inserisci almeno 2 caratteri', 'error'); return; }
        suggestionsBox.style.display = 'none';
        eseguiRicerca(val);
    });
 
    input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { btnCerca.click(); }
        if (e.key === 'Escape') { suggestionsBox.style.display = 'none'; }
    });
 
    btnClear.addEventListener('click', function() {
        input.value = '';
        suggestionsBox.style.display = 'none';
        resultsDiv.style.display = 'none';
        resultsDiv.innerHTML = '';
        btnClear.style.display = 'none';
    });
 
    document.addEventListener('click', function(e) {
        if (!e.target.closest('#booking-search-section')) {
            suggestionsBox.style.display = 'none';
        }
    });
}
 
async function eseguiRicerca(query) {
    var resultsDiv = document.getElementById('searchResults');
    var btnClear = document.getElementById('btnClearSearch');
    if (!resultsDiv) return;
    resultsDiv.innerHTML = '<div style="color: rgba(255,255,255,0.6); padding: 10px;">&#x1F504; Ricerca in corso...</div>';
    resultsDiv.style.display = 'block';
    if (btnClear) btnClear.style.display = 'inline-block';
 
    try {
        var r = await makeRequest('searchBookingsByName', { query: query });
        if (r.status !== 'ok') {
            resultsDiv.innerHTML = '<p style="color: #e74c3c;">Errore: ' + r.message + '</p>';
            return;
        }
        var bkgs = r.data.bookings;
        if (!bkgs.length) {
            resultsDiv.innerHTML = '<p style="color: rgba(255,255,255,0.6); padding: 8px 0;">Nessuna prenotazione futura trovata per <strong>' + query + '</strong>.</p>';
            return;
        }
 
        var html = '<p style="color: rgba(255,255,255,0.7); margin: 0 0 12px 0; font-size: 0.9rem;">' +
            bkgs.length + ' prenotazione/i future per <strong style="color: #74b9ff;">' + query + '</strong></p>' +
            '<div style="display: flex; flex-direction: column; gap: 8px;">';
 
        bkgs.forEach(function(b) {
            html += '<div style="display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.05); border-radius: 10px; padding: 12px 14px; border-left: 3px solid ' + getEventColor(b.evento) + ';">' +
                '<div>' +
                '<span style="font-weight: 700; color: white;">' + formatDate(b.data) + '</span>' +
                '<span style="color: rgba(255,255,255,0.7); margin: 0 10px;">&#x1F550; ' + b.ora + '</span>' +
                '<span>' + getEventName(b.evento) + '</span>' +
                '<span style="color: rgba(255,255,255,0.5); font-size: 0.85rem; margin-left: 8px;">&#x1F3DF; ' + getCampoName(b.campo) + '</span>' +
                '</div>' +
                '<button class="btn btn-danger search-delete-btn" data-id="' + b.id + '" data-nome="' + b.nome + '" style="padding: 5px 12px; font-size: 0.8rem; min-height: auto; width: auto;">&#x1F5D1;&#xFE0F;</button>' +
                '</div>';
        });
        html += '</div>';
        resultsDiv.innerHTML = html;
 
        resultsDiv.querySelectorAll('.search-delete-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var id = btn.dataset.id;
                var nome = btn.dataset.nome;
                var queryVal = query;
                showGenericConfirmModal(
                    'Elimina Prenotazione',
                    'Vuoi eliminare la prenotazione ' + id + ' di ' + nome + '?',
                    async function() {
                        try {
                            await makeRequest('deleteBooking', { bookingId: id });
                            showBanner('Prenotazione eliminata', 'success');
                            await loadInitialData(true);
                            eseguiRicerca(queryVal);
                        } catch(e) {
                            showBanner('Errore eliminazione', 'error');
                        }
                    }
                );
            });
        });
 
    } catch(e) {
        resultsDiv.innerHTML = '<p style="color: #e74c3c;">Errore di comunicazione con il server.</p>';
    }
}
 
