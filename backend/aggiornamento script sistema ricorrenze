function getBookingsWithCache(force) {
    if (force === undefined) force = false;
    var now = new Date().getTime();
    if (!force && cache.bookings && cache.timestamp && (now - cache.timestamp < cache.duration)) {
        return Promise.resolve({ data: { bookings: cache.bookings } });
    }
    return makeRequest('getBookings').then(function(result) {
        cache.bookings = (result.data.bookings || []).map(function(b) {
            return Object.assign({}, b, { data: b.data ? b.data.split('T')[0] : '' });
        });
        cache.timestamp = new Date().getTime();
        return { data: { bookings: cache.bookings } };
    }).catch(function(error) {
        if (cache.bookings) {
            showBanner('Errore di rete. Visualizzando dati non aggiornati.', 'error', 5000);
            return Promise.resolve({ data: { bookings: cache.bookings } });
        }
        return Promise.reject(error);
    });
}

async function loadInitialData(force) {
    if (force === undefined) force = false;
    try {
        var results = await Promise.all([
            getBookingsWithCache(force),
            makeRequest('getBookingsForCalendar'),
            makeRequest('getArchivedBookings').catch(function(e) {
                console.warn("Impossibile caricare eventi archiviati:", e);
                return { status: 'ok', data: { bookings: [] } };
            })
        ]);
        var result = results[0];
        var calendarResult = results[1];
        var archiveResult = results[2];

        try {
            var versionResult = await makeRequest('getAppVersion');
            if (versionResult.status === 'ok') {
                var versionEl = document.getElementById('app-version-footer');
                if (versionEl) versionEl.textContent = 'v.' + versionResult.data.version;
            }
        } catch(e) {}

        makeRequest('getConfiguration').then(function(r) {
            if (r && r.status === 'ok') applyConfiguration(r.data.config);
        }).catch(function() {});

        bookings = result.data.bookings;
        if (calendarResult.status === 'ok') calendarBookings = calendarResult.data.bookings;
        if (archiveResult.status === 'ok') archivedBookings = archiveResult.data.bookings;

        await updateAllPanels();
        refreshEventsCache();

        if (isAdminLoggedIn) {
            renderMonthlyCalendar();
            updateAdminManagementVisibility();
        }
        updateEmailFieldVisibility();

    } catch (error) {
        console.error("Failed to load initial data:", error);
        await updateAllPanels();
    }
}

