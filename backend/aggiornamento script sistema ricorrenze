var publicCalendarDate = new Date();
var calendarInitialized = false;
var isCalendarUpdating = false;

function initializePublicCalendar() {
    calendarInitialized = false;
    isCalendarUpdating = false;
    if (!publicCalendarDate || isNaN(publicCalendarDate.getTime())) {
        publicCalendarDate = new Date();
    }
    publicCalendarDate.setDate(1);
    var year = publicCalendarDate.getFullYear();
    var month = publicCalendarDate.getMonth() + 1;
    preloadMonthEvents(year, month);
    setupPublicCalendarListeners();
    renderPublicCalendar();
    calendarInitialized = true;
}

function setupPublicCalendarListeners() {
    var prevBtn = document.getElementById('publicPrevMonth');
    var nextBtn = document.getElementById('publicNextMonth');
    if (prevBtn) {
        var newPrevBtn = prevBtn.cloneNode(true);
        prevBtn.parentNode.replaceChild(newPrevBtn, prevBtn);
        document.getElementById('publicPrevMonth').addEventListener('click', function(e) {
            e.preventDefault();
            navigatePublicMonth(-1);
        });
    }
    if (nextBtn) {
        var newNextBtn = nextBtn.cloneNode(true);
        nextBtn.parentNode.replaceChild(newNextBtn, nextBtn);
        document.getElementById('publicNextMonth').addEventListener('click', function(e) {
            e.preventDefault();
            navigatePublicMonth(1);
        });
    }
}

function navigatePublicMonth(direction) {
    var currentYear = publicCalendarDate.getFullYear();
    var currentMonth = publicCalendarDate.getMonth();
    var newYear = currentYear;
    var newMonth = currentMonth + direction;
    if (newMonth > 11) { newYear++; newMonth = 0; }
    else if (newMonth < 0) { newYear--; newMonth = 11; }
    publicCalendarDate = new Date(newYear, newMonth, 1);
    renderPublicCalendar();
}

function renderPublicCalendar() {
    if (isCalendarUpdating) return;
    isCalendarUpdating = true;
    try {
        var month = publicCalendarDate.getMonth();
        var year = publicCalendarDate.getFullYear();
        var titleEl = document.getElementById('publicMonthYear');
        if (titleEl) {
            titleEl.textContent = new Date(year, month).toLocaleString("it-IT", { month: "long", year: "numeric" });
        }
        var weekdaysEl = document.getElementById('publicCalendarWeekdays');
        if (weekdaysEl && weekdaysEl.children.length === 0) {
            weekdaysEl.innerHTML = "";
            ["Lun", "Mar", "Mer", "Gio", "Ven", "Sab", "Dom"].forEach(function(day) {
                weekdaysEl.innerHTML += '<div class="calendar-day-header">' + day + '</div>';
            });
        }
        var daysEl = document.getElementById('publicCalendarDays');
        if (!daysEl) return;
        daysEl.innerHTML = "";

        var firstDayOfMonth = new Date(year, month, 1);
        var daysInMonth = new Date(year, month + 1, 0).getDate();
        var startDayOfWeek = firstDayOfMonth.getDay();
        startDayOfWeek = startDayOfWeek === 0 ? 6 : startDayOfWeek - 1;

        var prevMonth = month === 0 ? 11 : month - 1;
        var prevYear = month === 0 ? year - 1 : year;
        var daysInPrevMonth = new Date(prevYear, prevMonth + 1, 0).getDate();

        for (var i = startDayOfWeek - 1; i >= 0; i--) {
            createPublicCalendarDay(daysInPrevMonth - i, prevYear, prevMonth, true, daysEl);
        }
        for (var day = 1; day <= daysInMonth; day++) {
            createPublicCalendarDay(day, year, month, false, daysEl);
        }
        var totalCells = daysEl.children.length;
        var remainingCells = 42 - totalCells;
        var nextMonth = month === 11 ? 0 : month + 1;
        var nextYear = month === 11 ? year + 1 : year;
        for (var day = 1; day <= remainingCells; day++) {
            createPublicCalendarDay(day, nextYear, nextMonth, true, daysEl);
        }
    } catch (error) {
        console.error('Errore nella generazione del calendario pubblico:', error);
    } finally {
        isCalendarUpdating = false;
    }
}

function createPublicCalendarDay(dayNumber, year, month, isOtherMonth, container) {
    var dayEl = document.createElement('div');
    var dayDate = new Date(year, month, dayNumber);
    var today = new Date();
    dayEl.className = isOtherMonth ? 'public-calendar-day other-month' : 'public-calendar-day';
    var dateString = year + '-' + String(month + 1).padStart(2, '0') + '-' + String(dayNumber).padStart(2, '0');
    dayEl.dataset.date = dateString;

    if (!isOtherMonth && dayDate.toDateString() === today.toDateString()) {
        dayEl.classList.add('today');
    }

    var eventsForDay = [];
    var availability = { status: 'available', eventsCount: 0 };
    if (!isOtherMonth) {
        eventsForDay = getEventsForDatePublic(dateString);
        availability = checkDayAvailabilityFromEvents(eventsForDay, selectedEvent, dateString);
        dayEl.classList.add('availability-' + availability.status);
    }

    var centerContent = '';
    if (!isOtherMonth) {
        if (availability.status === 'closed') {
            centerContent = '<div class="public-day-center closed">' +
                '<div class="availability-indicator">' + getAvailabilityIcon(availability.status) + '</div>' +
                '<div class="public-event-label" style="font-size: 0.7rem; color: #e17055;">Chiuso</div></div>';
        } else if (eventsForDay.length === 0) {
            centerContent = '<div class="public-day-center available">' +
                '<div class="availability-indicator">' + getAvailabilityIcon(availability.status) + '</div></div>';
        } else if (eventsForDay.length === 1) {
            var event = eventsForDay[0];
            var eventIcon = ICONS[event.evento] || '&#x1F4C5;';
            var isRecurring = event.ricorrente === true || event.ricorrente === 'true';
            var recurringBadge = isRecurring ? '<span class="public-recurring-badge" title="Evento Ricorrente">&#x1F504;</span>' : '';
            centerContent = '<div class="public-day-center single-event">' +
                '<div class="public-event-row">' +
                '<span class="public-event-time">' + event.ora + '</span>' +
                '<span class="public-event-icon">' + eventIcon + '</span>' +
                recurringBadge + '</div>' +
                '<div class="public-event-type">' + getShortEventName(event.evento) + '</div>' +
                '<div class="availability-indicator small">' + getAvailabilityIcon(availability.status) + '</div></div>';
        } else {
            var recurringEvents = eventsForDay.filter(function(e) {
                return e.ricorrente === true || e.ricorrente === 'true';
            });
            var hasRecurring = recurringEvents.length > 0;
            centerContent = '<div class="public-day-center multiple-events">' +
                '<div class="public-events-count-row">' +
                '<span class="public-event-count">' + eventsForDay.length + '</span>' +
                (hasRecurring ? '<span class="public-recurring-badge">&#x1F504;</span>' : '') +
                '</div>' +
                '<div class="public-event-label">eventi</div>' +
                (hasRecurring ? '<div class="public-recurring-info">' + recurringEvents.length + ' ricorr.</div>' : '') +
                '<div class="availability-indicator small">' + getAvailabilityIcon(availability.status) + '</div></div>';
        }
    }

    dayEl.innerHTML = '<div class="day-number">' + dayNumber + '</div>' + centerContent;

    if (!isOtherMonth && availability.status !== 'occupied' && availability.status !== 'past' && availability.status !== 'closed') {
        (function(ds) {
            dayEl.addEventListener('click', function(e) {
                if (!e.target.closest('.public-event-bar') && !e.target.closest('.more-events-indicator')) {
                    openDayBookingModal(ds);
                }
            });
        })(dateString);
        dayEl.style.cursor = 'pointer';
    } else if (!isOtherMonth && availability.status === 'past') {
        dayEl.style.cursor = 'not-allowed';
    } else if (!isOtherMonth && availability.status === 'closed') {
        (function(ds) {
            dayEl.addEventListener('click', function() { showFacilityClosedModalForDate(ds); });
        })(dateString);
        dayEl.style.cursor = 'pointer';
    }

    if (!isOtherMonth && eventsForDay.length > 0) {
        var tooltipText = eventsForDay.map(function(e) {
            var recurringSymbol = (e.ricorrente === true || e.ricorrente === 'true') ? '&#x1F504; ' : '';
            return recurringSymbol + e.ora + ' - ' + getEventName(e.evento);
        }).join('\n');
        dayEl.title = tooltipText;
    }
    container.appendChild(dayEl);
}

function checkDayAvailabilityFromEvents(eventsForDay, eventType, dateString) {
    try {
        if (dateString && isDatePast(dateString)) {
            return { status: 'past', eventsCount: eventsForDay.length };
        }
        if (eventsForDay.length > 0) {
            var isSpecialEvent = eventType === 'compleanno' || eventType === 'eventi';
            if (isSpecialEvent) {
                var blockingEvents = eventsForDay.filter(function(event) {
                    if (event.campo === 'salone_melone') return false;
                    if (event.evento === 'compleanno' || event.evento === 'eventi') return true;
                    if (event.campo === 'entrambi' || event.campo === 'tutto') return true;
                    return false;
                });
                if (blockingEvents.length > 0) return { status: 'occupied', eventsCount: eventsForDay.length };
                return { status: 'special', eventsCount: eventsForDay.length };
            }
            var exclusiveEvents = eventsForDay.filter(function(event) {
                if (event.evento !== 'compleanno' && event.evento !== 'eventi') return false;
                if (event.campo === 'salone_melone') return false;
                if (event.campo === 'calcetto_salone') return eventType === 'calcetto';
                if (event.campo === 'pallavolo_salone') return eventType === 'pallavolo';
                if (event.campo === 'tutto' || event.campo === 'entrambi') return true;
                return event.campo === eventType;
            });
            if (exclusiveEvents.length > 0) return { status: 'occupied', eventsCount: eventsForDay.length };
            var conflictingEvents = eventsForDay.filter(function(event) {
                if (event.campo === 'salone_melone') return false;
                if (event.campo === 'calcetto_salone') return eventType === 'calcetto';
                if (event.campo === 'pallavolo_salone') return eventType === 'pallavolo';
                if (event.campo === 'tutto') return true;
                return event.campo === eventType || event.campo === 'entrambi';
            });
            if (conflictingEvents.length === 0) return { status: 'available', eventsCount: eventsForDay.length };
            return { status: 'partial', eventsCount: eventsForDay.length };
        }
        if (dateString) {
            var checkDate = new Date(dateString);
            if (checkDate.getDay() === 0) return { status: 'closed', eventsCount: 0 };
            var mm = String(checkDate.getMonth() + 1).padStart(2, '0');
            var dd = String(checkDate.getDate()).padStart(2, '0');
            var dateFormatted = mm + '-' + dd;
            var italianHolidays = ['01-01', '01-06', '04-25', '05-01', '06-02', '08-15', '11-01', '12-08', '12-25', '12-26'];
            if (italianHolidays.indexOf(dateFormatted) !== -1) return { status: 'closed', eventsCount: 0 };
        }
        var isSpecialEvent = eventType === 'compleanno' || eventType === 'eventi';
        if (isSpecialEvent) return { status: 'special', eventsCount: 0 };
        return { status: 'available', eventsCount: 0 };
    } catch (error) {
        console.error('Errore checkDayAvailabilityFromEvents:', error);
        return { status: 'available', eventsCount: 0 };
    }
}

function checkDayAvailability(dateString, eventType) {
    try {
        var dataSource = calendarBookings.length > 0 ? calendarBookings : bookings;
        var eventsForDay = dataSource.filter(function(event) {
            var eventDate = event.data ? event.data.split('T')[0] : '';
            return eventDate === dateString && event.stato !== 'rifiutato' && event.stato !== 'in_attesa';
        });
        return checkDayAvailabilityFromEvents(eventsForDay, eventType, dateString);
    } catch (error) {
        return { status: 'available', eventsCount: 0 };
    }
}

