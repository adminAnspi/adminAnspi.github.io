function debounce(func, wait) {
    var timeout;
    return function() {
        var args = arguments;
        var later = function() {
            clearTimeout(timeout);
            func.apply(this, args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
    };
}

