function confirmModalBooking(dateString) {
    var ora      = document.getElementById('modalOra').value;
    var nome     = document.getElementById('modalNome').value.trim();
    var email    = document.getElementById('modalEmail').value.trim();
    var telefono = document.getElementById('modalTelefono').value.trim();
    var note     = document.getElementById('modalNote').value.trim();

    if (dateString && ora) {
        var bookingDateTime = new Date(dateString + 'T' + ora + ':00');
        if (bookingDateTime < new Date()) {
            showBanner('Non e possibile prenotare per una data/ora gia passata.', 'error');
            return;
        }
    }
    if (!nome || !email || !telefono || !ora) {
        showBanner('Compila tutti i campi obbligatori', 'error');
        return;
    }

    var isSpecialEvent = selectedEvent === 'compleanno' || selectedEvent === 'eventi';
    var finalNote = note;
    if (isSpecialEvent) {
        var personCount  = document.getElementById('modalPersonCount').value;
        var musicOption  = document.querySelector('input[name="modalMusic"]:checked').value;
        var tablesOption = document.querySelector('input[name="modalTables"]:checked').value;
        var otherRequests = document.getElementById('modalOtherRequests').value.trim();
        if (!personCount) { showBanner('Inserisci il numero di persone', 'error'); return; }
        finalNote = 'Dettagli Evento Speciale:\n- Numero Persone: ' + personCount +
                    '\n- Impianto Musicale: ' + musicOption +
                    '\n- Tavoli e Sedie: ' + tablesOption;
        if (otherRequests) finalNote += '\n- Altre Richieste: ' + otherRequests;
        if (note) finalNote += '\n- Note Aggiuntive: ' + note;
    }

    var emailValue = (isAdminLoggedIn && currentAdminEmail) ? currentAdminEmail : email;
    var campoValue = isSpecialEvent ? (window._spazioSelezionato || 'entrambi') : selectedEvent;

    var booking = {
        id: 'ANSPI-' + generateShortId(),
        nome: nome,
        email: emailValue,
        telefono: telefono,
        evento: selectedEvent,
        campo: campoValue,
        data: dateString,
        ora: ora,
        note: finalNote,
        ricorrente: false,
        adminActionBy: isAdminLoggedIn && currentAdminEmail ? currentAdminEmail : undefined
    };

    if (isSpecialEvent) {
        showSpazioModal(function(spazio) {
            booking.campo = spazio;
            closeModal('details-modal');
            _proceedConfirmModalBooking(booking, dateString, ora);
        });
        return;
    }

    closeModal('details-modal');
    if (!isAdminLoggedIn && (selectedEvent === 'calcetto' || selectedEvent === 'pallavolo')) {
        checkAndWarnInvisibleRecurrence(dateString, ora, campoValue, false)
            .then(function(blocked) {
                if (blocked) return;
                _proceedConfirmModalBooking(booking, dateString, ora);
            });
        return;
    }
    _proceedConfirmModalBooking(booking, dateString, ora);
}

function _proceedConfirmModalBooking(booking, dateString, ora) {
    var dayEvents = getEventsForDate(dateString);
    function toDate(ds, ts) { return new Date(ds + 'T' + ts + ':00'); }
    var reqStart = toDate(dateString, ora);
    var reqEnd = new Date(reqStart.getTime() + (DURATIONS[booking.evento] || 90) * 60000);
    var overlaps = dayEvents.some(function(e) {
        var typeMatch = (e.evento === booking.evento) || (e.campo === booking.evento) || (e.campo === 'entrambi');
        if (!typeMatch || !e.ora) return false;
        var evStart = toDate(dateString, e.ora);
        var evEnd = new Date(evStart.getTime() + (DURATIONS[e.evento] || DURATIONS[booking.evento] || 90) * 60000);
        return (reqStart < evEnd) && (evStart < reqEnd);
    });
    currentBooking = booking;
    if (overlaps) {
        showBanner('Conflitto rilevato: propongo alternative...', 'info', 4000);
        finalConfirmBooking('calendar');
        return;
    }
    showConfirmModal(booking, function() { finalConfirmBooking('calendar'); });
}
