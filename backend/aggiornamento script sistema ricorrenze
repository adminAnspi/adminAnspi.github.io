}

function renderArchivedMonthlyCalendar() {
    var month = archiveCalendarDate.getMonth();
    var year = archiveCalendarDate.getFullYear();
    document.getElementById('archiveMonthYear').textContent = new Date(year, month).toLocaleString("it-IT", { month: "long", year: "numeric" });

    var daysEl = document.getElementById('archiveCalendarDays');
    daysEl.innerHTML = "";
    var weekdaysEl = document.getElementById('archiveCalendarWeekdays');
    weekdaysEl.innerHTML = "";
    ["Lun", "Mar", "Mer", "Gio", "Ven", "Sab", "Dom"].forEach(function(day) {
        weekdaysEl.innerHTML += '<div class="calendar-day-header">' + day + '</div>';
    });

    var firstDayOfMonth = new Date(year, month, 1);
    var daysInMonth = new Date(year, month + 1, 0).getDate();
    var startDayOfWeek = (firstDayOfMonth.getDay() + 6) % 7;
    for (var i = 0; i < startDayOfWeek; i++) {
        daysEl.innerHTML += '<div class="calendar-day other-month"></div>';
    }

    var today = new Date();
    var isCurrentMonth = month === today.getMonth() && year === today.getFullYear();
    var maxDay = isCurrentMonth ? today.getDate() : daysInMonth;

    for (var i = 1; i <= maxDay; i++) {
        var dayEl = document.createElement('div');
        dayEl.className = 'calendar-day';
        var dateString = year + '-' + String(month + 1).padStart(2, '0') + '-' + String(i).padStart(2, '0');
        dayEl.dataset.date = dateString;
        dayEl.innerHTML = '<div class="day-number">' + i + '</div><div class="events-container"></div>';
        var eventsForDay = getArchivedEventsForDate(dateString);

        if (eventsForDay.length > 0) {
            var eventsContainer = dayEl.querySelector('.events-container');
            var eventsByType = {};
            eventsForDay.forEach(function(event) {
                if (!eventsByType[event.evento]) eventsByType[event.evento] = [];
                eventsByType[event.evento].push(event);
            });

            eventsForDay.slice().sort(function(a, b) { return a.ora.localeCompare(b.ora); }).forEach(function(event) {
                var eventBar = document.createElement('div');
                eventBar.className = 'monthly-event-bar evento-' + event.evento;
                var eventTypeCount = eventsByType[event.evento].length;
                var eventIndex = eventsByType[event.evento].indexOf(event);
                var backgroundColor = getEventColor(event.evento);
                if (eventTypeCount > 1) {
                    var colorVariations = [
                        backgroundColor,
                        adjustColorBrightness(backgroundColor, 0.6),
                        adjustColorBrightness(backgroundColor, 1.4),
                        adjustColorHue(backgroundColor, 30)
                    ];
                    backgroundColor = colorVariations[eventIndex % colorVariations.length];
                }
                eventBar.style.background = backgroundColor;
                eventBar.style.filter = 'grayscale(50%)';
                eventBar.style.opacity = '0.7';
                eventBar.style.display = 'block';
                eventBar.style.position = 'relative';
                eventBar.style.marginBottom = '2px';

                var icon = ICONS[event.evento] || '';
                var truncatedName = truncateEventName(event.nome);
                var postitIndicator = '';
                if (event.postit) {
                    var postitParts = event.postit.toString().split('|');
                    var postitStatoVal = postitParts[0];
                    var coloriPostit = { 'svolto': '#00b894', 'non_svolto': '#e74c3c', 'parziale': '#f39c12' };
                    var colorePostit = coloriPostit[postitStatoVal] || '#fdcb6e';
                    postitIndicator = '<span style="position:absolute; top:2px; right:2px; width:8px; height:8px; border-radius:50%; background:' + colorePostit + '; display:inline-block;"></span>';
                }

                eventBar.innerHTML = '<span>' + event.ora + ' ' + icon + ' ' + truncatedName + '</span>' + postitIndicator;
                eventBar.title = '(ARCHIVIATO) ' + getEventName(event.evento) + '\n' + event.nome + (event.postit ? '\n' + event.postit.toString().split('|')[0] : '');
                eventBar.onclick = function(e) {
                    e.stopPropagation();
                    showDetailsModal(event);
                };
                eventsContainer.appendChild(eventBar);
            });
        }
        daysEl.appendChild(dayEl);
    }

    if (isCurrentMonth && maxDay < daysInMonth) {
        for (var i = maxDay + 1; i <= daysInMonth; i++) {
            var dayEl = document.createElement('div');
            dayEl.className = 'calendar-day future-day';
            dayEl.innerHTML = '<div class="day-number">' + i + '</div><div class="events-container"></div>';
            dayEl.style.opacity = '0.3';
            daysEl.appendChild(dayEl);
        }
    }
}

