    var statusIcon = document.getElementById('trigger-status-icon');
    var statusTitle = document.getElementById('trigger-status-title');
    var statusSubtitle = document.getElementById('trigger-status-subtitle');
    if (!statusDiv) return;
    try {
        var result = await makeRequest('getTriggerStatusDetailed');
        if (result.status === 'ok' && result.data) {
            var data = result.data;
            var isActive = data.active && data.count > 0;
            if (isActive) {
                statusDiv.className = 'trigger-status-modern active';
                statusIcon.innerHTML = '&#x2705;';
                statusTitle.textContent = 'Sistema Attivo';
                if (data.triggers && data.triggers.length > 0) {
                    var details = data.triggers.map(function(t) { return t.icona + ' ' + t.descrizione; }).join(' • ');
                    statusSubtitle.textContent = data.count + ' trigger configurati: ' + details;
                } else {
                    statusSubtitle.textContent = data.count + ' trigger configurati - Sistema funzionante';
                }
            } else {
                statusDiv.className = 'trigger-status-modern inactive';
                statusIcon.innerHTML = '&#x274C;';
                statusTitle.textContent = 'Sistema Non Attivo';
                statusSubtitle.textContent = 'Nessun trigger configurato';
            }
        } else {
            statusDiv.className = 'trigger-status-modern inactive';
            statusIcon.innerHTML = '&#x26A0;&#xFE0F;';
            statusTitle.textContent = 'Errore Verifica';
            statusSubtitle.textContent = result.message || 'Impossibile verificare';
        }
    } catch (error) {
        if (statusDiv) {
            statusDiv.className = 'trigger-status-modern inactive';
            statusIcon.textContent = '&#x26A0;&#xFE0F;';
            statusTitle.textContent = 'Errore Connessione';
            statusSubtitle.textContent = 'Impossibile contattare il server';
        }
    }
}

