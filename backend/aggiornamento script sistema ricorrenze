async function showAdminTab(tabName) {
    if (isAdminLoggedIn) updateAdminManagementVisibility();
    document.querySelectorAll('.admin-tab').forEach(function(tab) { tab.classList.remove('active'); });
    document.querySelectorAll('.admin-content').forEach(function(content) { content.style.display = 'none'; });
    var tabBtn = document.querySelector('.admin-tab[data-tab="' + tabName + '"]');
    if (tabBtn) tabBtn.classList.add('active');
    var content = document.getElementById('admin-' + tabName);
    if (content) content.style.display = 'block';
    setupSmartRecurringListeners();

    if (tabName === 'calendar') {
        await refreshCalendarData();
        renderMonthlyCalendar();
    }
else if (tabName === 'archive-calendar') {
        try {
            var daysEl = document.getElementById('archiveCalendarDays');
            if (daysEl) {
                daysEl.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 40px; color: white;">&#x1F504; Caricamento archivio...</div>';
            }
            var result = await makeRequest('getArchivedBookings');
            if (result.status === 'ok' && result.data) {
                var archiveData = result.data.bookings;
                if (!Array.isArray(archiveData)) {
                    if (archiveData && typeof archiveData === 'object') {
                        archiveData = Object.values(archiveData);
                    } else {
                        archiveData = [];
                    }
                }
                archivedBookings = archiveData;
            } else {
                archivedBookings = [];
            }
        } catch (error) {
            console.error('Errore caricamento archivio:', error);
            archivedBookings = [];
            showBanner('Errore caricamento archivio: ' + error.message, 'error');
        }
        renderArchivedMonthlyCalendar();
    }

    updateStats();

    if (tabName === 'gestione-campo') {
        // nessuna azione extra
    }
    if (tabName === 'gestione-admin') {
        loadAdminsList();
    }
    if (tabName === 'configurazione') {
        loadConfiguration();
    }
