// ===== CACHE GLOBALE PER EVENTI =====
var eventsCache = {
    data: null,
    lastUpdate: null,
    monthYear: null
};

function preloadMonthEvents(year, month) {
    var monthKey = year + '-' + month.toString().padStart(2, '0');
    if (eventsCache.monthYear === monthKey && eventsCache.lastUpdate) {
        var cacheAge = Date.now() - eventsCache.lastUpdate;
        if (cacheAge < 60000) {
            return eventsCache.data;
        }
    }
    var dataSource = calendarBookings.length > 0 ? calendarBookings : bookings;
    var monthEvents = {};
    var daysInMonth = new Date(year, month, 0).getDate();
    for (var day = 1; day <= daysInMonth; day++) {
        var dateString = year + '-' + month.toString().padStart(2, '0') + '-' + day.toString().padStart(2, '0');
        monthEvents[dateString] = calculateEventsForDate(dateString, dataSource);
    }
    eventsCache = {
        data: monthEvents,
        lastUpdate: Date.now(),
        monthYear: monthKey
    };
    return monthEvents;
}

function calculateEventsForDate(dateString, dataSource) {
    try {
        var today = new Date();
        var todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());
        var currentDate = new Date(dateString.split('T')[0]);
        var currentDateStr = dateString.split('T')[0];

        var singleEvents = dataSource.filter(function(b) {
            var isRecurring = b.ricorrente === true || b.ricorrente === 'TRUE' || b.ricorrente === 'true' || b.ricorrente === 'si';
            if (!b.data || isRecurring) return false;
            return b.data.split('T')[0] === currentDateStr;
        });

        var recurringEvents = dataSource
            .filter(function(b) {
                var isRecurring = b.ricorrente === true || b.ricorrente === 'TRUE' || b.ricorrente === 'true' || b.ricorrente === 'si';
                return isRecurring && b.data;
            })
            .filter(function(masterEvent) {
                var masterDateStr = masterEvent.data.split('T')[0];
                var masterDate = new Date(masterDateStr);
                var nextOccurrence = new Date(masterDate);
                nextOccurrence.setDate(masterDate.getDate() + 7);
                var nextOccurrenceStr = nextOccurrence.getFullYear() + '-' +
                    String(nextOccurrence.getMonth() + 1).padStart(2, '0') + '-' +
                    String(nextOccurrence.getDate()).padStart(2, '0');
                var isMasterDate = masterDateStr === currentDateStr;
                var isNextOccurrence = nextOccurrenceStr === currentDateStr;
                var isNotPast = currentDate >= todayStart;
                return (isMasterDate || isNextOccurrence) && isNotPast;
            })
            .map(function(masterEvent) {
                return Object.assign({}, masterEvent, { data: dateString, id: masterEvent.id + '-V' });
            });

        var combined = singleEvents.concat(recurringEvents)
            .filter(function(event) {
                return event.stato !== 'in_attesa' && event.stato !== 'rifiutato';
            });

        var seenIds = {};
        combined = combined.filter(function(e) {
            var baseId = e.id.toString().replace('-V', '');
            if (seenIds[baseId]) return false;
            seenIds[baseId] = true;
            return true;
        });

        var hasExtraordinary = combined.some(function(e) {
            return (e.evento === 'compleanno' || e.evento === 'eventi') && !e.id.toString().includes('-V');
        });

        if (hasExtraordinary) {
            return combined.filter(function(e) {
                var isCalcettoOrVolley = e.evento === 'calcetto' || e.evento === 'pallavolo';
                return !(isCalcettoOrVolley && e.id.toString().includes('-V'));
            });
        }

        return combined;
    } catch (error) {
        console.error('Errore calculateEventsForDate:', error);
        return [];
    }
}

function getEventsForDateOptimized(dateString) {
    var parts = dateString.split('-').map(Number);
    var year = parts[0];
    var month = parts[1];
    var monthKey = year + '-' + month.toString().padStart(2, '0');
    if (!eventsCache.data || eventsCache.monthYear !== monthKey) {
        preloadMonthEvents(year, month);
    }
    return eventsCache.data[dateString] || [];
}

function getEventsForDate(dateString) {
    return getEventsForDateOptimized(dateString);
}

function getEventsForDatePublic(dateString) {
    try {
        return getEventsForDateOptimized(dateString);
    } catch (error) {
        console.error('Errore getEventsForDatePublic:', error);
        return [];
    }
}

function refreshEventsCache() {
    eventsCache = { data: null, lastUpdate: null, monthYear: null };
}

function initOptimizedCalendar(year, month) {
    preloadMonthEvents(year, month);
}

function renderMonthlyCalendar() {
    var month = calendarDate.getMonth();
    var year = calendarDate.getFullYear();
    initOptimizedCalendar(year, month + 1);

    if (calendarBookings && calendarBookings.length > 0) {
        calendarBookings = calendarBookings.filter(function(event) {
            var isRecurring = event.ricorrente === true || event.ricorrente === 'TRUE' ||
                              event.ricorrente === 'true' || event.ricorrente === 'si';
            if (isRecurring) return true;
            return !event.archiviato;
        });
    }

    document.getElementById('monthYear').textContent = new Date(year, month).toLocaleString("it-IT", { month: "long", year: "numeric" });

    var daysEl = document.getElementById('calendarDays');
    daysEl.innerHTML = "";
    var weekdaysEl = document.getElementById('calendarWeekdays');
    weekdaysEl.innerHTML = "";
    ["Lun", "Mar", "Mer", "Gio", "Ven", "Sab", "Dom"].forEach(function(day) {
        weekdaysEl.innerHTML += '<div class="calendar-day-header">' + day + '</div>';
    });

    var firstDayOfMonth = new Date(year, month, 1);
    var daysInMonth = new Date(year, month + 1, 0).getDate();
    var startDayOfWeek = (firstDayOfMonth.getDay() + 6) % 7;

    for (var i = 0; i < startDayOfWeek; i++) {
        daysEl.innerHTML += '<div class="calendar-day other-month"></div>';
    }

    for (var i = 1; i <= daysInMonth; i++) {
        var dayEl = document.createElement('div');
        dayEl.className = 'calendar-day';
        var dateString = year + '-' + String(month + 1).padStart(2, '0') + '-' + String(i).padStart(2, '0');
        dayEl.dataset.date = dateString;

        var today = new Date();
        if (i === today.getDate() && month === today.getMonth() && year === today.getFullYear()) {
            dayEl.classList.add('today');
        }

        var eventsForDay = getEventsForDate(dateString);
        var centerContent = '';
        var dayClasses = '';

        if (eventsForDay.length > 0) {
            if (eventsForDay.length === 1) {
                var event = eventsForDay[0];
                var eventIcon = ICONS[event.evento] || '&#x1F4C5;';
                var isRecurring = event.ricorrente === true || event.ricorrente === 'true';
                var recurringBadge = isRecurring ? '<span class="recurring-badge-inline" title="Evento Ricorrente">&#x1F504;</span>' : '';
                centerContent = '<div class="day-center-content single-event">' +
                    '<div class="event-info-row">' +
                    '<span class="day-event-time">' + event.ora + '</span>' +
                    '<span class="day-event-icon">' + eventIcon + '</span>' +
                    recurringBadge + '</div>' +
                    '<div class="day-event-type">' + getShortEventName(event.evento) + '</div></div>';
                dayClasses = 'has-event evento-' + event.evento;
                if (isRecurring) dayClasses += ' is-recurring';
            } else {
                var recurringEvents = eventsForDay.filter(function(e) {
                    return e.ricorrente === true || e.ricorrente === 'true';
                });
                var hasRecurring = recurringEvents.length > 0;
                centerContent = '<div class="day-center-content multiple-events">' +
                    '<div class="events-count-row">' +
                    '<span class="day-event-count">' + eventsForDay.length + '</span>' +
                    (hasRecurring ? '<span class="recurring-badge-inline">&#x1F504;</span>' : '') +
                    '</div>' +
                    '<div class="day-event-label">eventi</div>' +
                    (hasRecurring ? '<div class="recurring-info">' + recurringEvents.length + ' ricorr.</div>' : '') +
                    '</div>';
                dayClasses = 'has-multiple-events';
                if (hasRecurring) dayClasses += ' has-recurring';
            }
        } else {
            var isPast = isDatePast(dateString);
            if (isPast) {
                centerContent = '<div class="day-center-content past"><div class="availability-indicator">&#x26AB;</div></div>';
                dayClasses = 'day-past';
            } else {
                centerContent = '<div class="day-center-content available"><div class="availability-indicator">&#x1F7E2;</div></div>';
                dayClasses = 'day-available';
            }
        }

        dayEl.innerHTML = '<div class="day-number">' + i + '</div>' + centerContent;
        if (dayClasses) dayEl.className += ' ' + dayClasses;

        if (eventsForDay.length > 0 && eventsForDay.length <= 3) {
            var eventsContainer = document.createElement('div');
            eventsContainer.className = 'events-container-mini';
            eventsForDay.slice(0, 3).forEach(function(event) {
                var eventBar = document.createElement('div');
                eventBar.className = 'mini-event-bar evento-' + event.evento;
                eventBar.style.background = getEventColor(event.evento);
                eventsContainer.appendChild(eventBar);
            });
            dayEl.appendChild(eventsContainer);
        }

        (function(ds, events) {
            dayEl.onclick = function(e) {
                if (!e.target.closest('.monthly-event-bar')) {
                    if (events.length > 0) showDaySummaryModal(ds, events);
                }
            };
        })(dateString, eventsForDay);

        if (eventsForDay.length > 0) {
            var tooltipText = eventsForDay.map(function(e) {
                var recurringSymbol = (e.ricorrente === true || e.ricorrente === 'true') ? '&#x1F504; ' : '';
                return recurringSymbol + e.ora + ' - ' + getEventName(e.evento) + ' (' + e.nome + ')';
            }).join('\n');
            dayEl.title = tooltipText;
        }

        daysEl.appendChild(dayEl);
    }

    if (isAdminLoggedIn) {
        setTimeout(function() {
            setupCalendarDoubleClick();
            addCalendarTooltips();
        }, 100);
    }
}

function renderWeeklyCalendar() {
    var timeLabelsEl = document.getElementById('timeLabels');
    var daysContainerEl = document.getElementById('daysContainer');
    timeLabelsEl.innerHTML = '';
    daysContainerEl.innerHTML = '';

    for (var i = 8; i <= 22; i++) {
        timeLabelsEl.innerHTML += '<div class="time-label">' + i + ':00</div>';
    }

    var startOfWeek = new Date(calendarDate);
    startOfWeek.setDate(startOfWeek.getDate() - (startOfWeek.getDay() + 6) % 7);
    var endOfWeek = new Date(startOfWeek);
    endOfWeek.setDate(startOfWeek.getDate() + 6);
    document.getElementById('weekRange').textContent = formatDate(startOfWeek.toISOString().split('T')[0]) + ' - ' + formatDate(endOfWeek.toISOString().split('T')[0]);

    for (var i = 0; i < 7; i++) {
        var day = new Date(startOfWeek);
        day.setDate(startOfWeek.getDate() + i);
        var dayStr = day.toISOString().split('T')[0];
        var dayName = day.toLocaleDateString('it-IT', { weekday: 'short' });
        var dayHtml = '<div class="day-column"><div class="day-column-header">' + dayName + ' ' + day.getDate() + '</div>';
        var eventsForDay = getEventsForDate(dayStr);
        eventsForDay.sort(function(a, b) { return a.ora.localeCompare(b.ora); }).forEach(function(event) {
            var parts = event.ora.split(':').map(Number);
            var hour = parts[0];
            var minute = parts[1];
            var top = ((hour - 8) * 60 + minute);
            var durationMap = { calcetto: 90, pallavolo: 120, compleanno: 180, eventi: 180 };
            var duration = durationMap[event.evento] || 60;
            var isRecurring = event.ricorrente === true || event.ricorrente === 'TRUE' ||
                              event.ricorrente === 'true' || event.ricorrente === 'si';
            var icon = isRecurring && !event.id.includes('-V') ? '&#x1F504;' : '';
            dayHtml += '<div class="weekly-event evento-' + event.evento + '" ' +
                'style="top:' + top + 'px; height:' + duration + 'px; background: ' + getEventColor(event.evento) + ';" ' +
                'data-event=\'' + JSON.stringify(event) + '\'>' +
                '<div class="event-time">' + event.ora + ' ' + icon + '</div>' +
                '<div class="event-title">' + getEventName(event.evento) + '</div>' +
                '<div class="event-name">' + (isRecurring && !event.id.includes('-V') ? event.nome + ' &#x1F504;' : event.nome) + '</div>' +
                '<div class="event-phone" style="font-size: 0.7rem; opacity: 0.9; margin-top: 2px;">' + ICONS.telefono + ' ' + (event.telefono || 'N/D') + '</div>' +
                '</div>';
        });
        dayHtml += '</div>';
        daysContainerEl.innerHTML += dayHtml;
    }

    daysContainerEl.addEventListener('click', function(e) {
        var eventCard = e.target.closest('.weekly-event');
        if (eventCard) showDetailsModal(JSON.parse(eventCard.dataset.event));
    });

    var lastTapTime = 0;
    var lastTapTarget = null;
    daysContainerEl.addEventListener('touchend', function(e) {
        var eventCard = e.target.closest('.weekly-event');
        if (!eventCard) return;
        var now = Date.now();
        if (lastTapTarget === eventCard && (now - lastTapTime) < 350) {
            try { showDetailsModal(JSON.parse(eventCard.dataset.event)); } catch(err) {}
            lastTapTime = 0;
            lastTapTarget = null;
        } else {
            lastTapTime = now;
            lastTapTarget = eventCard;
        }
    }, { passive: true });
}

function toggleCalendarView(view) {
    document.getElementById('monthly-view').style.display = view === 'monthly' ? 'block' : 'none';
    document.getElementById('weekly-view').style.display = view === 'weekly' ? 'block' : 'none';
