function makeRequest(action, data, retryCount) {
    if (data === undefined) data = {};
    if (retryCount === undefined) retryCount = 0;
    var MAX_RETRIES = 3;
    var BASE_DELAY = 2000;

    return new Promise(function(resolve, reject) {
        var timeoutMs = action === 'createBooking' ? 45000 : 20000;
        var timeout = setTimeout(function() {
            if (retryCount < MAX_RETRIES) {
                var delay = BASE_DELAY * Math.pow(2, retryCount);
                setTimeout(function() {
                    makeRequest(action, data, retryCount + 1).then(resolve).catch(reject);
                }, delay);
            } else {
                updateStatus('Timeout - Troppi tentativi', false);
                reject(new Error('Timeout dopo multipli tentativi'));
            }
        }, timeoutMs);

        try {
            google.script.run
                .withSuccessHandler(function(response) {
                    clearTimeout(timeout);
                    if (!response || response.status === 'error') {
                        var errorMessage = response ? response.message : "Errore sconosciuto";
                        updateStatus('Offline', false);
                        showBanner('Errore: ' + errorMessage, 'error');
                        reject(new Error(errorMessage));
                    } else {
                        updateStatus('Connesso', true);
                        resolve(response);
                    }
                })
                .withFailureHandler(function(error) {
                    clearTimeout(timeout);
                    if (error.message && error.message.includes('429')) {
                        if (retryCount < MAX_RETRIES) {
                            var delay = BASE_DELAY * Math.pow(2, retryCount);
                            showBanner('Sistema occupato - Riprovo tra ' + (delay/1000) + ' secondi...', 'warning', delay);
                            setTimeout(function() {
                                makeRequest(action, data, retryCount + 1).then(resolve).catch(reject);
                            }, delay);
                        } else {
                            updateStatus('Offline', false);
                            showBanner('Sistema sovraccarico. Attendi qualche minuto e riprova.', 'error', 8000);
                            reject(new Error('Rate limit superato'));
                        }
                    } else if (error.message && error.message.includes('message port')) {
                        setTimeout(function() {
                            google.script.run
                                .withSuccessHandler(resolve)
                                .withFailureHandler(reject)
                                .serverRequest(action, data);
                        }, 1000);
                    } else {
                        updateStatus('Offline', false);
                        showBanner('Errore: ' + error.message, 'error');
                        reject(error);
                    }
                })
                .serverRequest(action, data);
        } catch (error) {
            clearTimeout(timeout);
            reject(error);
        }
    });
}

